@page "/"
@using System.Globalization
@inject AssetCatalogService AssetCatalogService
@inject DashboardDataService DashboardDataService
@inject MarketDataService MarketDataService
@inject NavigationManager NavigationManager

<PageTitle>Stock Predictor Core</PageTitle>

@if (_isLoading)
{
    <section class="dashboard-empty panel-shell">
        <span class="section-kicker">Core wird geladen</span>
        <h1>Lokale Kursdaten und Modell-Payload werden vorbereitet.</h1>
        <p>Es wird kein Training beim Websitebesuch gestartet.</p>
    </section>
}
else
{
    var payload = _snapshot?.Payload;
    var searchResults = GetSearchResults();
    var homeEntries = GetHomeEntries();

    <div class="dashboard-page">
        @if (payload is null)
        {
            <section class="panel-shell status-banner">
                <div>
                    <span class="section-kicker">Core-Payload fehlt</span>
                    <h2>Die App kann Kursdaten laden, aber noch keine gespeicherten Predictions anzeigen.</h2>
                    <p>
                        Erzeuge zuerst lokal Modelle, Predictions und den Core-Dashboard-Payload.
                        Die Webapp trainiert bewusst nicht automatisch.
                    </p>
                </div>
                <div class="command-list">
                    <code>cd StockPredictor.ML</code>
                    <code>.\.venv\Scripts\python.exe scripts\train_model_suite.py --symbols AAPL TSLA MSFT NVDA ENR.DE SIE.DE --horizon 5</code>
                    <code>.\.venv\Scripts\python.exe scripts\export_dashboard_payload.py</code>
                </div>
            </section>
        }

        <section class="market-hero panel-shell" id="market">
            <div class="hero-copy">
                <span class="section-kicker">Core-Version</span>
                <h1>Kursdaten, gespeicherte Modelle und nachvollziehbare Modellprognosen.</h1>
                <p>
                    Diese Version konzentriert sich auf Laden von Kursdaten, konsistente Charts,
                    gespeicherte Modellartefakte und transparente Forecast-Metadaten. Keine Anlageberatung.
                </p>

                <div class="hero-actions">
                    <a class="action-link action-primary" href="#asset-discovery">Assets suchen</a>
                    <a class="action-link" href="#forecasts">Forecast-Status</a>
                    <a class="action-link" href="hinweise">Methodik</a>
                </div>
            </div>

            <div class="hero-stats">
                <article class="hero-stat">
                    <span>Bekannte Assets</span>
                    <strong>@_assetEntries.Count</strong>
                    <small>Suche aus Katalog und Payload</small>
                </article>
                <article class="hero-stat">
                    <span>Kurskarten</span>
                    <strong>@homeEntries.Count</strong>
                    <small>Lokaler Market Data Layer</small>
                </article>
                <article class="hero-stat">
                    <span>Forecasts</span>
                    <strong>@(payload?.FeaturedTickers.Count ?? 0)</strong>
                    <small>Aus gespeicherten Modellen</small>
                </article>
                <article class="hero-stat">
                    <span>Payload erzeugt</span>
                    <strong>@(payload is null ? "n/a" : FormatDateTime(payload.GeneratedAt))</strong>
                    <small>Kein Live-Training</small>
                </article>
                <article class="hero-stat">
                    <span>Kursdaten bis</span>
                    <strong>@FormatTimestamp(GetNewestMarketTimestamp(homeEntries))</strong>
                    <small>Geladene Markt-Snapshots</small>
                </article>
                <article class="hero-stat">
                    <span>Forecast-Daten bis</span>
                    <strong>@(payload is null ? "n/a" : FormatNullableDate(payload.DataUntil))</strong>
                    <small>@(payload is null ? "Noch kein Payload" : GetPayloadFreshnessLabel(payload))</small>
                </article>
            </div>
        </section>

        <section class="discovery-grid" id="asset-discovery">
            <article class="panel-shell discovery-panel">
                <div class="panel-header">
                    <div>
                        <span class="section-kicker">Asset-Suche</span>
                        <h2>Ticker oder Namen suchen</h2>
                    </div>
                    <span class="meta-pill">@_assetEntries.Count bekannte Assets</span>
                </div>

                <form class="search-form" @onsubmit="HandleAssetSearchSubmit" @onsubmit:preventDefault="true">
                    <label class="sr-only" for="asset-search-input">Ticker oder Asset suchen</label>
                    <input id="asset-search-input"
                           class="search-input"
                           type="search"
                           placeholder="z. B. AAPL, TSLA, MSFT, siemens energy"
                           @bind="_assetSearchQuery"
                           @bind:event="oninput" />
                    <button class="status-button" type="submit" disabled="@string.IsNullOrWhiteSpace(GetSearchTargetTicker())">
                        Asset öffnen
                    </button>
                </form>

                @if (searchResults.Count > 0)
                {
                    <div class="asset-result-list">
                        @foreach (var asset in searchResults)
                        {
                            <article class="asset-result-row">
                                <div class="asset-result-copy">
                                    <div class="asset-result-head">
                                        <div class="asset-title-block">
                                            <strong>@asset.Ticker</strong>
                                            @if (!string.IsNullOrWhiteSpace(asset.DisplayName))
                                            {
                                                <small>@asset.DisplayName</small>
                                            }
                                        </div>
                                        <div class="asset-result-badges">
                                            @if (!string.IsNullOrWhiteSpace(asset.AssetType))
                                            {
                                                <span class="meta-pill">@asset.AssetType</span>
                                            }
                                            <span class="tone-pill @GetForecastAvailabilityTone(asset)">
                                                @GetForecastAvailabilityLabel(asset)
                                            </span>
                                        </div>
                                    </div>
                                    <div class="asset-result-metrics">
                                        <span>Letzter Kurs <strong>@FormatNullablePrice(GetAssetLastPrice(asset))</strong></span>
                                        <span>Kursdaten <strong>@FormatTimestamp(GetAssetLastTimestamp(asset))</strong></span>
                                        @if (asset.ForecastHorizonChangePct is double horizonChange)
                                        {
                                            <span>Forecast <strong class="@GetTrendTone(horizonChange)">@FormatPercent(horizonChange)</strong></span>
                                        }
                                    </div>
                                </div>

                                <div class="asset-result-actions">
                                    <button class="action-button action-primary" type="button" @onclick="() => OpenAsset(asset.Ticker)">
                                        Details
                                    </button>
                                </div>
                            </article>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_assetSearchQuery))
                {
                    <article class="search-empty">
                        <span class="section-kicker">Kein bekannter Treffer</span>
                        <h3>@AssetCatalogService.NormalizeTicker(_assetSearchQuery)</h3>
                        <p>Die Kursansicht kann trotzdem geöffnet werden. Ein Forecast braucht vorher ein gespeichertes Core-Modell.</p>
                        <button class="action-button action-secondary" type="button" @onclick="() => OpenAsset(AssetCatalogService.NormalizeTicker(_assetSearchQuery))">
                            Kursansicht öffnen
                        </button>
                    </article>
                }
            </article>

            <article class="panel-shell discovery-panel">
                <div class="panel-header">
                    <div>
                        <span class="section-kicker">Core-Ablauf</span>
                        <h2>Training und Prediction laufen offline</h2>
                    </div>
                    <span class="meta-pill">Kein Auto-Retraining</span>
                </div>
                <div class="run-list">
                    <div>
                        <span>1. Training</span>
                        <strong>Untermodelle trainieren und bewerten</strong>
                        <small>Persistence, Ridge und Random Forest mit chronologischer Validierung.</small>
                    </div>
                    <div>
                        <span>2. Registry</span>
                        <strong>Bestes Modell je Asset/Horizont speichern</strong>
                        <small>Modellpfade, Featureliste, Metriken, Datenstand und Trainingszeitpunkt.</small>
                    </div>
                    <div>
                        <span>3. Prediction</span>
                        <strong>Forecast aus gespeicherten Modellen erzeugen</strong>
                        <small>Ohne neues Training beim Websitebesuch.</small>
                    </div>
                </div>
            </article>
        </section>

        <section class="market-board panel-shell" id="ticker-board">
            <div class="panel-header board-header">
                <div>
                    <span class="section-kicker">Kurskarten</span>
                    <h2>Marktdaten und Forecast-Status</h2>
                </div>
                <span class="meta-pill">Core-Hauptflow</span>
            </div>

            <div class="market-card-grid">
                @foreach (var asset in homeEntries)
                {
                    <MarketTickerCard Asset="asset"
                                      MarketSnapshot="GetMarketSnapshot(asset.Ticker)"
                                      RangeChanges="GetRangeChanges(asset.Ticker)"
                                      ForecastJob="@null"
                                      PrimaryRange="MarketTimeRange.OneMonth"
                                      IsInWatchlist="false"
                                      IsForecastStale="IsAssetForecastStale(asset)"
                                      ShowSecondaryAction="false"
                                      OnOpen="OpenAssetFromCard" />
                }
            </div>
        </section>

        <section class="panel-shell" id="forecasts">
            <div class="panel-header">
                <div>
                    <span class="section-kicker">Forecast-Status</span>
                    <h2>Gespeicherte Predictions aus der Core-Registry</h2>
                </div>
                <span class="meta-pill">Keine Anlageberatung</span>
            </div>

            @if (payload?.FeaturedTickers.Count > 0)
            {
                <div class="compact-ranking">
                    @foreach (var ticker in payload.FeaturedTickers)
                    {
                        <article>
                            <span>@ticker.Ticker</span>
                            <strong>@ticker.ForecastModelLabel</strong>
                            <small>
                                Training @FormatNullableDateTime(ticker.ModelTrainedAt) ·
                                Forecast @FormatNullableDateTime(ticker.ForecastGeneratedAt) ·
                                RMSE @FormatRmse(ticker.WalkForwardBestRmse)
                            </small>
                        </article>
                    }
                </div>
            }
            else
            {
                <p class="card-copy">Noch keine gespeicherten Core-Predictions im Dashboard-Payload vorhanden.</p>
            }
        </section>
    </div>
}

@code {
    private static readonly CultureInfo UiCulture = CultureInfo.GetCultureInfo("de-DE");
    private static readonly string[] DefaultCoreTickers = ["AAPL", "TSLA", "MSFT", "NVDA", "ENR.DE", "SIE.DE"];

    private DashboardDataSnapshot? _snapshot;
    private IReadOnlyList<AssetCatalogEntry> _assetEntries = [];
    private readonly Dictionary<string, MarketAssetSnapshot> _marketSnapshots = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, IReadOnlyDictionary<MarketTimeRange, MarketRangeChange>> _marketChanges = new(StringComparer.OrdinalIgnoreCase);
    private string _assetSearchQuery = string.Empty;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _snapshot = await DashboardDataService.GetLatestAsync();
        _assetEntries = AssetCatalogService.BuildEntries(_snapshot.Payload);
        await RefreshMarketOverviewAsync();
        _isLoading = false;
    }

    private async Task RefreshMarketOverviewAsync()
    {
        var tickers = GetHomeTickers();
        var snapshots = await MarketDataService.GetSnapshotsAsync(tickers);

        _marketSnapshots.Clear();
        _marketChanges.Clear();

        foreach (var (ticker, snapshot) in snapshots)
        {
            _marketSnapshots[ticker] = snapshot;
            _marketChanges[ticker] = MarketDataService.GetRangeChanges(snapshot);
        }
    }

    private IReadOnlyList<string> GetHomeTickers()
    {
        var tickers = new List<string>();
        if (_snapshot?.Payload is not null)
        {
            tickers.AddRange(_snapshot.Payload.FeaturedTickers.Select(ticker => ticker.Ticker));
        }

        tickers.AddRange(DefaultCoreTickers);
        return tickers
            .Select(AssetCatalogService.NormalizeTicker)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(8)
            .ToArray();
    }

    private IReadOnlyList<AssetCatalogEntry> GetHomeEntries()
    {
        return GetHomeTickers()
            .Select(ticker => _assetEntries.FirstOrDefault(entry =>
                string.Equals(entry.Ticker, ticker, StringComparison.OrdinalIgnoreCase))
                ?? AssetCatalogService.CreatePlaceholderEntry(ticker))
            .ToArray();
    }

    private IReadOnlyList<AssetCatalogEntry> GetSearchResults()
    {
        return AssetCatalogService.Search(_assetEntries, _assetSearchQuery);
    }

    private string? GetSearchTargetTicker()
    {
        if (string.IsNullOrWhiteSpace(_assetSearchQuery))
        {
            return null;
        }

        return AssetCatalogService.ResolveTicker(_assetSearchQuery, _assetEntries);
    }

    private async Task HandleAssetSearchSubmit()
    {
        var targetTicker = GetSearchTargetTicker();
        if (!string.IsNullOrWhiteSpace(targetTicker))
        {
            OpenAsset(targetTicker);
        }

        await Task.CompletedTask;
    }

    private void OpenAsset(string tickerSymbol)
    {
        NavigationManager.NavigateTo($"/assets/{Uri.EscapeDataString(AssetCatalogService.NormalizeTicker(tickerSymbol))}");
    }

    private Task OpenAssetFromCard(string tickerSymbol)
    {
        OpenAsset(tickerSymbol);
        return Task.CompletedTask;
    }

    private MarketAssetSnapshot? GetMarketSnapshot(string ticker)
    {
        _marketSnapshots.TryGetValue(AssetCatalogService.NormalizeTicker(ticker), out var snapshot);
        return snapshot;
    }

    private IReadOnlyDictionary<MarketTimeRange, MarketRangeChange> GetRangeChanges(string ticker)
    {
        return _marketChanges.TryGetValue(AssetCatalogService.NormalizeTicker(ticker), out var ranges)
            ? ranges
            : new Dictionary<MarketTimeRange, MarketRangeChange>();
    }

    private double? GetAssetLastPrice(AssetCatalogEntry asset)
    {
        return GetMarketSnapshot(asset.Ticker)?.LastPoint?.Close ?? asset.LastClose;
    }

    private DateTime? GetAssetLastTimestamp(AssetCatalogEntry asset)
    {
        return GetMarketSnapshot(asset.Ticker)?.LastPoint?.Timestamp;
    }

    private bool IsAssetForecastStale(AssetCatalogEntry asset)
    {
        if (asset.FeaturedTicker is null || _snapshot?.Payload is null)
        {
            return false;
        }

        var staleAfterDays = _snapshot.Payload.StaleAfterDays > 0 ? _snapshot.Payload.StaleAfterDays : 5;
        var dataUntil = asset.FeaturedTicker.DataUntil ?? _snapshot.Payload.DataUntil ?? asset.FeaturedTicker.LastCloseDate;
        var today = DateOnly.FromDateTime(DateTime.Now);
        return today.DayNumber - dataUntil.DayNumber > staleAfterDays;
    }

    private DateTime? GetNewestMarketTimestamp(IEnumerable<AssetCatalogEntry> entries)
    {
        return entries
            .Select(entry => GetMarketSnapshot(entry.Ticker)?.LastPoint?.Timestamp)
            .Where(timestamp => timestamp is not null)
            .Max();
    }

    private static string GetForecastAvailabilityTone(AssetCatalogEntry entry)
    {
        if (entry.ForecastAvailable)
        {
            return "tone-positive";
        }

        return entry.HasPreparedPayloadData ? "tone-neutral" : "tone-negative";
    }

    private static string GetForecastAvailabilityLabel(AssetCatalogEntry entry)
    {
        if (entry.ForecastAvailable)
        {
            return "Forecast verfügbar";
        }

        return entry.HasPreparedPayloadData ? "Payload vorhanden" : "Noch kein Forecast";
    }

    private static string GetPayloadFreshnessLabel(DashboardPayload payload)
    {
        var staleAfterDays = payload.StaleAfterDays > 0 ? payload.StaleAfterDays : 5;
        if (payload.DataUntil is null)
        {
            return "Datenstand unbekannt";
        }

        var today = DateOnly.FromDateTime(DateTime.Now);
        var dataAgeDays = today.DayNumber - payload.DataUntil.Value.DayNumber;
        return dataAgeDays > staleAfterDays ? $"Älter als {staleAfterDays} Tage" : "Lokal aktuell";
    }

    private static string FormatDate(DateOnly date) => date.ToString("dd. MMM yyyy", UiCulture);

    private static string FormatNullableDate(DateOnly? date) => date is null ? "n/a" : FormatDate(date.Value);

    private static string FormatDateTime(DateTime dateTime) => dateTime.ToString("dd. MMM yyyy | HH:mm", UiCulture);

    private static string FormatNullableDateTime(DateTime? value) => value is null ? "n/a" : FormatDateTime(value.Value);

    private static string FormatTimestamp(DateTime? value) => value is null ? "n/a" : value.Value.ToString("dd. MMM yyyy | HH:mm", UiCulture);

    private static string FormatNullablePrice(double? value) => value is null ? "n/a" : value.Value.ToString("N2", UiCulture);

    private static string FormatRmse(double value) => value.ToString("0.000", UiCulture);

    private static string FormatPercent(double value) => $"{(value >= 0 ? "+" : string.Empty)}{value.ToString("0.00", UiCulture)}%";

    private static string GetTrendTone(double value)
    {
        return value switch
        {
            > 0.01 => "tone-positive",
            < -0.01 => "tone-negative",
            _ => "tone-neutral",
        };
    }
}
