@page "/"
@using System.Globalization
@inject AssetCatalogService AssetCatalogService
@inject BrowserWatchlistService BrowserWatchlistService
@inject DashboardDataService DashboardDataService
@inject NewsService NewsService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Stock-Predictor-Dashboard</PageTitle>

@if (_isLoading)
{
    <section class="dashboard-empty panel-shell">
        <span class="section-kicker">Laden</span>
        <h1>Dashboard wird aufgebaut...</h1>
        <p>Die App lädt den neuesten Dashboard-Payload aus der ML-Pipeline.</p>
    </section>
}
else if (_snapshot?.Payload is null)
{
    var isMissingPayload = _snapshot?.IsMissing == true;
    var emptyStateKicker = isMissingPayload ? "Payload fehlt" : "Payload ungültig";
    var emptyStateTitle = isMissingPayload
        ? "Lokale Dashboard-Daten fehlen auf diesem Rechner"
        : "Dashboard-Payload konnte nicht gelesen werden";
    var emptyStateMessage = isMissingPayload
        ? "Die Blazor-App erwartet einen lokal erzeugten Dashboard-Export. Nach einem frischen Clone ist das normal, wenn die ML-Artefakte unter StockPredictor.ML/storage/ noch nicht lokal vorhanden sind."
        : (_snapshot?.ErrorMessage ?? "Der Dashboard-Payload konnte nicht geladen werden.");

    <section class="dashboard-empty panel-shell">
        <span class="section-kicker">@emptyStateKicker</span>
        <h1>@emptyStateTitle</h1>
        <p>@emptyStateMessage</p>

        <div class="detail-stats-grid">
            <article class="mini-stat">
                <span>Fehlende Datei</span>
                <strong>dashboard_payload.json</strong>
                <small>@_snapshot?.ResolvedPath</small>
            </article>
            <article class="mini-stat">
                <span>Typische Ursache</span>
                <strong>Lokale ML-Artefakte fehlen</strong>
                <small>Die Daten unter StockPredictor.ML/storage/ müssen lokal erzeugt oder übernommen werden.</small>
            </article>
        </div>

        <div class="empty-state-meta">
            <span class="meta-pill">Erwartete Datei</span>
            <code>@_snapshot?.ResolvedPath</code>
        </div>
        <div class="empty-state-command">
            <span class="meta-pill">Typische Befehle</span>
            <code>cd StockPredictor.ML</code>
            <code>.\.venv\Scripts\python.exe export_dashboard_payload.py</code>
        </div>
        <div class="empty-state-actions">
            <button class="status-button" type="button" @onclick="ReloadDashboardAsync" disabled="@_isLoading">
                Datenstatus prüfen
            </button>
            <p class="empty-state-hint">
                Wenn die Datei weiterhin fehlt, muss zuerst der lokale ML-Stand für den Pfad storage/dashboard/LATEST erzeugt werden.
            </p>
        </div>
    </section>
}
else if (_snapshot.Payload.FeaturedTickers.Count == 0)
{
    <section class="dashboard-empty panel-shell">
        <span class="section-kicker">Payload ohne Ticker</span>
        <h1>Der Dashboard-Export enthält noch keine Featured-Ticker</h1>
        <p>
            Die App bleibt bewusst lauffähig, aber für die Startseite werden mindestens einige exportierte Tickerdaten benötigt.
        </p>
        <div class="empty-state-meta">
            <span class="meta-pill">Quelle</span>
            <code>@_snapshot?.ResolvedPath</code>
        </div>
    </section>
}
else
{
    var payload = _snapshot.Payload;
    var newsSnapshot = _newsSnapshot;
    var activeTicker = GetActiveTicker(payload);
    var activeAsset = GetAssetEntry(activeTicker.Ticker);
    var activeRanking = GetActiveRankingEntry(payload, activeTicker.Ticker);
    var starterSummary = payload.SummaryCards.StarterBestExperiment;
    var coreSummary = payload.SummaryCards.BestCoreProfile;
    var diversifiedSummary = payload.SummaryCards.BestDiversifiedProfile;
    var starterBeaters = payload.SummaryCards.StarterTickersBeatingBaseline;
    var rankingEntries = payload.CompanyRanking;
    var searchResults = GetSearchResults();
    var watchlistEntries = GetWatchlistEntries();
    var searchTargetTicker = GetSearchTargetTicker();

    <div class="dashboard-page">
        <section class="market-hero panel-shell" id="market">
            <div class="hero-copy">
                <span class="section-kicker">Marktüberblick</span>
                <h1>Wichtige Ticker zuerst, ML-Ergebnisse separat markiert.</h1>
                <p>Letzte Schlusskurse, kompakte Modellgüte und Forschungsprognosen auf einen Blick.</p>

                <div class="hero-actions">
                    <a class="action-link action-primary" href="#asset-discovery">Assets suchen</a>
                    <a class="action-link" href="hinweise">FAQ & Methodik</a>
                </div>
            </div>

            <div class="hero-stats">
                <article class="hero-stat">
                    <span>Beobachtete Ticker</span>
                    <strong>@payload.FeaturedTickers.Count</strong>
                    <small>Vorbereitete Marktansicht</small>
                </article>
                <article class="hero-stat">
                    <span class="metric-label">ML-Ausblick positiv <InfoTooltip TermKey="forecast" /></span>
                    <strong>@GetPositiveOutlookCount(payload) / @payload.FeaturedTickers.Count</strong>
                    <small>5-Tage-Horizont</small>
                </article>
                <article class="hero-stat">
                    <span>Dominantes Modell</span>
                    <strong class="metric-value-with-help">
                        @GetDominantForecastModelLabel(payload)
                        @if (GetDominantForecastModelExplanationTermKey(payload) is { } dominantModelTermKey)
                        {
                            <InfoTooltip TermKey="@dominantModelTermKey" />
                        }
                    </strong>
                    <small>über die Startseite</small>
                </article>
                <article class="hero-stat">
                    <span class="metric-label">Baseline geschlagen <InfoTooltip TermKey="persistence_baseline" /></span>
                    <strong>@starterBeaters.Count / @starterSummary.TickerCount</strong>
                    <small>Starter-Korb</small>
                </article>
                <article class="hero-stat">
                    <span class="metric-label">Datenstand <InfoTooltip TermKey="forecast" /></span>
                    <strong>@FormatNullableDate(payload.DataUntil)</strong>
                    <small>@GetPayloadFreshnessLabel(payload)</small>
                </article>
            </div>
        </section>

        <section class="discovery-grid" id="asset-discovery">
            <article class="panel-shell discovery-panel">
                <div class="panel-header">
                    <div>
                        <span class="section-kicker">Asset-Suche</span>
                        <h2>Ticker, Aktien und ETFs im Payload durchsuchen</h2>
                    </div>
                    <span class="meta-pill">@_assetEntries.Count Assets im lokalen Dashboard</span>
                </div>

                <form class="search-form" @onsubmit="HandleAssetSearchSubmit" @onsubmit:preventDefault="true">
                    <label class="sr-only" for="asset-search-input">Ticker oder Asset suchen</label>
                    <input id="asset-search-input"
                           class="search-input"
                           type="search"
                           placeholder="Ticker oder Name eingeben, z. B. AAPL, TSLA oder ETF"
                           @bind="_assetSearchQuery"
                           @bind:event="oninput" />
                    <button class="status-button" type="submit" disabled="@string.IsNullOrWhiteSpace(searchTargetTicker)">
                        Asset öffnen
                    </button>
                </form>

                <div class="search-meta">
                    <span class="meta-pill">
                        @(string.IsNullOrWhiteSpace(_assetSearchQuery)
                            ? "Top-Assets aus Featured-Tickern, Ranking und Multi-Asset-Körben"
                            : $"Treffer für „{_assetSearchQuery.Trim()}“")
                    </span>
                    @if (!string.IsNullOrWhiteSpace(_assetSearchQuery))
                    {
                        <button class="text-button" type="button" @onclick="ClearAssetSearch">
                            Suche zurücksetzen
                        </button>
                    }
                </div>

                @if (searchResults.Count > 0)
                {
                    <div class="asset-result-list">
                        @foreach (var asset in searchResults)
                        {
                            <article class="asset-result-row">
                                <div class="asset-result-copy">
                                    <div class="asset-result-head">
                                        <div class="asset-title-block">
                                            <strong>@asset.Ticker</strong>
                                            @if (!string.IsNullOrWhiteSpace(asset.DisplayName))
                                            {
                                                <small>@asset.DisplayName</small>
                                            }
                                        </div>
                                        <div class="asset-result-badges">
                                            @if (!string.IsNullOrWhiteSpace(asset.AssetType))
                                            {
                                                <span class="meta-pill">@asset.AssetType</span>
                                            }
                                            <span class="tone-pill @GetForecastAvailabilityTone(asset)">
                                                @GetForecastAvailabilityLabel(asset)
                                            </span>
                                        </div>
                                    </div>

                                    <div class="asset-result-metrics">
                                        <span>Letzter Kurs <strong>@FormatNullablePrice(asset.LastClose)</strong></span>
                                        <span>Stand <strong>@FormatNullableDate(asset.LastCloseDate)</strong></span>
                                        @if (asset.ForecastHorizonChangePct is double horizonChange)
                                        {
                                            <span>5 Tage <strong class="@GetTrendTone(horizonChange)">@FormatPercent(horizonChange)</strong></span>
                                        }
                                    </div>
                                </div>

                                <div class="asset-result-actions">
                                    <button class="action-button action-primary" type="button" @onclick="() => OpenAsset(asset.Ticker)">
                                        Öffnen
                                    </button>
                                    <button class="action-button action-secondary" type="button" @onclick="() => ToggleWatchlistAsync(asset.Ticker)">
                                        @GetWatchlistButtonLabel(asset.Ticker)
                                    </button>
                                </div>
                            </article>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_assetSearchQuery))
                {
                    <article class="search-empty">
                        <span class="section-kicker">Noch kein vorbereiteter Treffer</span>
                        <h3>@AssetCatalogService.NormalizeTicker(_assetSearchQuery)</h3>
                        <p>Für dieses Asset liegen aktuell keine vorbereiteten Prognosedaten vor.</p>
                        <p>ML-Lauf muss hierfür erzeugt werden.</p>
                        <button class="action-button action-secondary" type="button" @onclick="() => OpenAsset(AssetCatalogService.NormalizeTicker(_assetSearchQuery))">
                            Platzhalter-Ansicht öffnen
                        </button>
                    </article>
                }
            </article>

            <article class="panel-shell discovery-panel">
                <div class="panel-header">
                    <div>
                        <span class="section-kicker">Meine Watchlist</span>
                        <h2>Favoriten lokal im Browser speichern</h2>
                    </div>
                    <span class="meta-pill">@_watchlistTickers.Count gespeicherte Ticker</span>
                </div>

                @if (!_watchlistLoaded)
                {
                    <p class="watchlist-empty-copy">Die lokale Watchlist wird geladen.</p>
                }
                else if (watchlistEntries.Count == 0)
                {
                    <div class="watchlist-empty">
                        <p class="watchlist-empty-copy">
                            Noch keine lokalen Favoriten gespeichert. Füge Ticker über die Suche oder die Detailansicht hinzu.
                        </p>
                    </div>
                }
                else
                {
                    <div class="watchlist-saved-list">
                        @foreach (var asset in watchlistEntries)
                        {
                            <article class="watchlist-saved-row">
                                <div class="asset-result-copy">
                                    <div class="asset-result-head">
                                        <div class="asset-title-block">
                                            <strong>@asset.Ticker</strong>
                                            @if (!string.IsNullOrWhiteSpace(asset.DisplayName))
                                            {
                                                <small>@asset.DisplayName</small>
                                            }
                                        </div>
                                        <div class="asset-result-badges">
                                            @if (!string.IsNullOrWhiteSpace(asset.AssetType))
                                            {
                                                <span class="meta-pill">@asset.AssetType</span>
                                            }
                                            <span class="tone-pill @GetForecastAvailabilityTone(asset)">
                                                @GetForecastAvailabilityLabel(asset)
                                            </span>
                                        </div>
                                    </div>

                                    <div class="asset-result-metrics">
                                        <span>Letzter Kurs <strong>@FormatNullablePrice(asset.LastClose)</strong></span>
                                        <span>Stand <strong>@FormatNullableDate(asset.LastCloseDate)</strong></span>
                                    </div>
                                </div>

                                <div class="asset-result-actions">
                                    <button class="action-button action-primary" type="button" @onclick="() => OpenAsset(asset.Ticker)">
                                        Details
                                    </button>
                                    <button class="action-button action-secondary" type="button" @onclick="() => ToggleWatchlistAsync(asset.Ticker)">
                                        Entfernen
                                    </button>
                                </div>
                            </article>
                        }
                    </div>
                }
            </article>
        </section>

        <section class="market-board panel-shell" id="ticker-board">
            <div class="panel-header board-header">
                <div>
                    <span class="section-kicker">Vorbereitete Assets</span>
                    <h2>Ticker-Kacheln und schneller Marktstatus</h2>
                </div>

                <div class="surface-toggle" role="tablist" aria-label="Ansicht wechseln">
                    <button class="@GetSurfaceTabClass(DashboardSurfaceMode.PricesOnly)"
                            type="button"
                            @onclick="() => SetSurfaceMode(DashboardSurfaceMode.PricesOnly)">
                        Nur Kurse
                    </button>
                    <button class="@GetSurfaceTabClass(DashboardSurfaceMode.PricesAndForecast)"
                            type="button"
                            @onclick="() => SetSurfaceMode(DashboardSurfaceMode.PricesAndForecast)">
                        Kurse + Prognose
                    </button>
                    <button class="@GetSurfaceTabClass(DashboardSurfaceMode.ModelComparison)"
                            type="button"
                            @onclick="() => SetSurfaceMode(DashboardSurfaceMode.ModelComparison)">
                        Modellvergleich
                    </button>
                </div>
            </div>

            <div class="watchlist-grid">
                @foreach (var ticker in payload.FeaturedTickers)
                {
                    var rankingEntry = GetActiveRankingEntry(payload, ticker.Ticker);

                    <article class="watchlist-shell @(ticker.Ticker == activeTicker.Ticker ? "is-active" : string.Empty)">
                        <button class="watchlist-card"
                                type="button"
                                @onclick="() => SelectTicker(ticker.Ticker)">
                            <div class="watchlist-head">
                                <div>
                                    <span class="watchlist-symbol">@ticker.Ticker</span>
                                    <small>@FormatDate(ticker.LastCloseDate)</small>
                                </div>
                                <span class="tone-pill @(GetTrendTone(ticker.ForecastHorizonChangePct))">
                                    @GetResearchOutlookLabel(ticker)
                                </span>
                            </div>

                            <div class="watchlist-price-row">
                                <span>Letzter Schlusskurs</span>
                                <strong>@FormatPrice(ticker.LastClose)</strong>
                            </div>

                            @if (_activeSurfaceMode == DashboardSurfaceMode.PricesOnly)
                            {
                                <div class="watchlist-metrics">
                                    <div>
                                        <span>Modell</span>
                                        <strong>@FormatModelLabel(ticker.ForecastModel, ticker.ForecastModelLabel)</strong>
                                    </div>
                                    <div>
                                        <span>Benchmark</span>
                                        <strong class="@GetBenchmarkTone(ticker)">@GetBenchmarkLabel(ticker)</strong>
                                    </div>
                                </div>
                                <p class="watchlist-note">
                                    ML-Kurzstatus: @FormatPercent(ticker.ForecastHorizonChangePct) über 5 Tage.
                                    Forschungsmarker, kein Handelssignal.
                                </p>
                            }
                            else if (_activeSurfaceMode == DashboardSurfaceMode.PricesAndForecast)
                            {
                                <div class="watchlist-metrics">
                                    <div>
                                        <span>Nächste ML-Prognose</span>
                                        <strong>@FormatPrice(ticker.NextPredictedClose)</strong>
                                    </div>
                                    <div>
                                        <span>5 Tage ML</span>
                                        <strong class="@GetTrendTone(ticker.ForecastHorizonChangePct)">
                                            @FormatPercent(ticker.ForecastHorizonChangePct)
                                        </strong>
                                    </div>
                                </div>
                                <p class="watchlist-note">
                                    @FormatFeatureProfileLabel(ticker.FeatureProfile) /
                                    @FormatModelLabel(ticker.ForecastModel, ticker.ForecastModelLabel)
                                </p>
                            }
                            else
                            {
                                <div class="watchlist-metrics">
                                    <div>
                                        <span>Gewähltes Modell</span>
                                        <strong>@GetSelectedModelLabel(ticker)</strong>
                                    </div>
                                    <div>
                                        <span>Vergleichsmodelle</span>
                                        <strong>@ticker.AvailableModels.Count</strong>
                                    </div>
                                </div>
                                <p class="watchlist-note">
                                    Walk-Forward-RMSE @FormatRmse(ticker.WalkForwardBestRmse) /
                                    Richtung @FormatRatePercent(ticker.WalkForwardBestDirectionalAccuracy * 100)
                                </p>
                            }

                            <div class="watchlist-footer">
                                <span>@(rankingEntry is not null ? $"#{rankingEntry.Rank} im Ranking" : "Featured Ticker")</span>
                                <span>Fokus öffnen</span>
                            </div>
                        </button>
                    </article>
                }
            </div>
        </section>

        <section class="focus-grid">
            <article class="panel-shell focus-panel" id="ticker-detail">
                <div class="panel-header">
                    <div>
                        <span class="section-kicker">@GetFocusKicker()</span>
                        <h2>@activeTicker.Ticker</h2>
                        @if (!string.IsNullOrWhiteSpace(activeAsset.DisplayName))
                        {
                            <p class="asset-subtitle">
                                @activeAsset.DisplayName
                                @if (!string.IsNullOrWhiteSpace(activeAsset.AssetType))
                                {
                                    <span>· @activeAsset.AssetType</span>
                                }
                            </p>
                        }
                    </div>

                    <div class="detail-badges">
                        <span class="meta-pill">Stand @FormatDate(activeTicker.LastCloseDate)</span>
                        @if (activeRanking is not null)
                        {
                            <span class="meta-pill">Ranking Platz @activeRanking.Rank</span>
                        }
                        <span class="meta-pill">@GetFreshnessLabel(payload, activeTicker)</span>
                    </div>
                </div>

                <div class="detail-actions">
                    <button class="action-button action-secondary" type="button" @onclick="() => ToggleWatchlistAsync(activeTicker.Ticker)">
                        @GetWatchlistButtonLabel(activeTicker.Ticker)
                    </button>
                    <a class="action-link action-primary" href="@GetAssetHref(activeTicker.Ticker)">Asset-Details</a>
                </div>

                <div class="forecast-meta-grid">
                    <article class="meta-card">
                        <span>Datenstand</span>
                        <strong>@FormatNullableDate(GetDataUntil(payload, activeTicker))</strong>
                        <small>Historische Daten bis zum letzten im Export enthaltenen Kurs</small>
                    </article>
                    <article class="meta-card">
                        <span>Prognose erzeugt am</span>
                        <strong>@FormatDateTime(GetForecastGeneratedAt(payload, activeTicker))</strong>
                        <small>Zuletzt exportierter ML-Stand, keine Live-Prognose</small>
                    </article>
                    <article class="meta-card">
                        <span>Modell / Methode</span>
                        <strong class="metric-value-with-help">
                            @GetSelectedModelLabel(activeTicker)
                            @if (GetModelExplanationTermKey(activeTicker.SelectedModel.ModelKey, activeTicker.ForecastModel) is { } selectedModelTermKey)
                            {
                                <InfoTooltip TermKey="@selectedModelTermKey" />
                            }
                        </strong>
                        <small>Holdout: @FormatModelKey(activeTicker.HoldoutBestModel) · Walk-Forward: @FormatModelKey(activeTicker.WalkForwardBestModel)</small>
                    </article>
                    <article class="meta-card">
                        <span>Prognosehorizont</span>
                        <strong>@GetForecastHorizonDays(activeTicker) Handelstage</strong>
                        <small>Von @FormatDate(activeTicker.NextForecastDate) bis @FormatDate(activeTicker.ForecastEndDate)</small>
                    </article>
                </div>

                @if (IsTickerStale(payload, activeTicker))
                {
                    <div class="stale-banner">
                        Diese Prognose basiert auf einem älteren Export.
                    </div>
                }

                @if (_activeSurfaceMode == DashboardSurfaceMode.PricesOnly)
                {
                    <div class="detail-stats-grid">
                        <article class="mini-stat">
                            <span>Letzter Schlusskurs</span>
                            <strong>@FormatPrice(activeTicker.LastClose)</strong>
                            <small>@FormatDate(activeTicker.LastCloseDate)</small>
                        </article>
                        <article class="mini-stat">
                            <span>ML-Kurzstatus</span>
                            <strong class="@GetTrendTone(activeTicker.ForecastHorizonChangePct)">
                                @FormatPercent(activeTicker.ForecastHorizonChangePct)
                            </strong>
                            <small>5 Tage Forschungshorizont</small>
                        </article>
                        <article class="mini-stat">
                            <span>Modellbewertung</span>
                            <strong>@FormatRatePercent(activeTicker.WalkForwardBestDirectionalAccuracy * 100)</strong>
                            <small>Richtungstreffer Walk-Forward</small>
                        </article>
                        <article class="mini-stat">
                            <span class="metric-label">Benchmark <InfoTooltip TermKey="persistence_baseline" /></span>
                            <strong class="@GetBenchmarkTone(activeTicker)">
                                @GetBenchmarkLabel(activeTicker)
                            </strong>
                            <small>@FormatSignedRmse(activeTicker.WalkForwardBestRmse - activeTicker.WalkForwardBaselineRmse)</small>
                        </article>
                        <article class="mini-stat">
                            <span class="metric-label">Feature-Profil <InfoTooltip TermKey="feature_profile" /></span>
                            <strong>@FormatFeatureProfileLabel(activeTicker.FeatureProfile)</strong>
                            <small>@FormatModelLabel(activeTicker.ForecastModel, activeTicker.ForecastModelLabel)</small>
                        </article>
                        <article class="mini-stat">
                            <span>Datenfenster</span>
                            <strong>@FormatDate(activeTicker.DataStart)</strong>
                            <small>bis @FormatDate(activeTicker.DataEnd)</small>
                        </article>
                    </div>

                    <article class="research-callout">
                        <span class="section-kicker">Forschungsrahmen</span>
                        <h3>Prognosen bleiben bewusst optional zuschaltbar</h3>
                        <p>
                            Die Startseite priorisiert Kurse und kompakte Modellqualität. ML-Prognosen erscheinen im separaten
                            Tab und bleiben klar als Forschungsergebnis markiert.
                        </p>
                    </article>
                }
                else if (_activeSurfaceMode == DashboardSurfaceMode.PricesAndForecast)
                {
                    <div class="research-banner">
                        Modellprognose als forschungsbasierte Schätzung. Keine Anlageberatung.
                    </div>

                    <div class="detail-stats-grid">
                        <article class="mini-stat">
                            <span>Letzter Schlusskurs</span>
                            <strong>@FormatPrice(activeTicker.LastClose)</strong>
                            <small>@FormatDate(activeTicker.LastCloseDate)</small>
                        </article>
                        <article class="mini-stat">
                            <span class="metric-label">Nächste ML-Prognose <InfoTooltip TermKey="forecast" /></span>
                            <strong>@FormatPrice(activeTicker.NextPredictedClose)</strong>
                            <small>@FormatPercent(activeTicker.NextPredictedChangePct)</small>
                        </article>
                        <article class="mini-stat">
                            <span>5-Tage-Horizont</span>
                            <strong class="@GetTrendTone(activeTicker.ForecastHorizonChangePct)">
                                @FormatPercent(activeTicker.ForecastHorizonChangePct)
                            </strong>
                            <small>Forecast-Ende @FormatDate(activeTicker.ForecastEndDate)</small>
                        </article>
                        <article class="mini-stat">
                            <span class="metric-label">Richtungstreffer <InfoTooltip TermKey="directional_accuracy" /></span>
                            <strong>@FormatRatePercent(activeTicker.WalkForwardBestDirectionalAccuracy * 100)</strong>
                            <small>Walk-Forward</small>
                        </article>
                        <article class="mini-stat">
                            <span>Abstand zur Baseline</span>
                            <strong class="@GetGapTone(activeTicker.WalkForwardBestRmse - activeTicker.WalkForwardBaselineRmse)">
                                @FormatSignedRmse(activeTicker.WalkForwardBestRmse - activeTicker.WalkForwardBaselineRmse)
                            </strong>
                            <small>@GetBenchmarkLabel(activeTicker)</small>
                        </article>
                        <article class="mini-stat">
                            <span>Durchschnittlicher Abstand</span>
                            <strong>@FormatPrice(activeTicker.AverageForecastDistanceToLastClose)</strong>
                            <small>@FormatPlainPercent(activeTicker.AverageForecastDistancePctToLastClose)</small>
                        </article>
                        <article class="mini-stat">
                            <span>Modell</span>
                            <strong>@FormatModelLabel(activeTicker.ForecastModel, activeTicker.ForecastModelLabel)</strong>
                            <small>@FormatFeatureProfileLabel(activeTicker.FeatureProfile)</small>
                        </article>
                    </div>

                    <div class="forecast-panel">
                        <div class="forecast-panel-header">
                            <div>
                                <span class="section-kicker">ML-Prognosepfad</span>
                                <h3>Prognostizierter Schlusskursverlauf</h3>
                            </div>
                            <div class="forecast-legend">
                                <span class="legend-dot"></span>
                                <span>Letzter Schlusskurs + Prognosepfad</span>
                            </div>
                        </div>

                        <ForecastSparkline Values="@GetSparklineValues(activeTicker)"
                                           TrendTone="@MapToneToSparkline(activeTicker.ForecastHorizonChangePct)"
                                           AriaLabel="@($"{activeTicker.Ticker} Prognosepfad")" />
                    </div>

                    <div class="forecast-strip">
                        @foreach (var point in activeTicker.ForecastPath)
                        {
                            <article class="forecast-day">
                                <span>@FormatDate(point.Date)</span>
                                <strong>@FormatPrice(point.PredictedClose)</strong>
                                <small class="@GetTrendTone(point.PredictedReturn * 100)">
                                    @FormatPercent(point.PredictedReturn * 100)
                                </small>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="research-banner">
                        <span class="metric-label">Modellvergleich auf Basis von Backtesting <InfoTooltip TermKey="backtesting" /> und vorhandenen Test- und Walk-Forward-Metriken.</span>
                        <span>Keine Anlageberatung.</span>
                    </div>

                    @if (activeTicker.ModelMetrics.Count > 0)
                    {
                        <div class="model-compare-grid">
                            @foreach (var modelMetric in activeTicker.ModelMetrics)
                            {
                                <article class="model-compare-card @(modelMetric.IsSelected ? "is-selected" : string.Empty)">
                                    <div class="model-card-header">
                                        <div>
                                            <span class="section-kicker">Modell / Methode</span>
                                            <h3 class="metric-value-with-help">
                                                @modelMetric.ModelLabel
                                                @if (GetModelExplanationTermKey(modelMetric.ModelKey) is { } modelTermKey)
                                                {
                                                    <InfoTooltip TermKey="@modelTermKey" />
                                                }
                                            </h3>
                                        </div>
                                        <span class="tone-pill @(GetGapTone(modelMetric.WalkForwardRmseGapVsBaseline ?? 0))">
                                            @(modelMetric.IsSelected ? "Aktive Modellprognose" : "Vergleichsmodell")
                                        </span>
                                    </div>

                                    <div class="model-next-step">
                                        <span>Nächste Schätzung</span>
                                        <strong>@FormatNullablePrice(modelMetric.NextPredictedClose)</strong>
                                        <small>@FormatNullablePercent(modelMetric.NextPredictedChangePct)</small>
                                    </div>

                                    <div class="model-metric-grid">
                                        <div>
                                            <span class="metric-label">Walk-Forward RMSE <InfoTooltip TermKey="walk_forward_validation" /></span>
                                            <strong>@FormatNullableRmse(modelMetric.WalkForwardRmse)</strong>
                                            <small>@FormatNullableSignedRmse(modelMetric.WalkForwardRmseGapVsBaseline)</small>
                                        </div>
                                        <div>
                                            <span class="metric-label">Walk-Forward MAE <InfoTooltip TermKey="mae" /></span>
                                            <strong>@FormatNullableRmse(modelMetric.WalkForwardMae)</strong>
                                            <small>@FormatNullableSignedRmse(modelMetric.WalkForwardMaeGapVsBaseline)</small>
                                        </div>
                                        <div>
                                            <span class="metric-label">Richtungstreffer <InfoTooltip TermKey="directional_accuracy" /></span>
                                            <strong>@FormatNullableRatePercent(modelMetric.WalkForwardDirectionalAccuracy)</strong>
                                            <small>gegen Baseline @FormatNullableRateGapPercent(modelMetric.WalkForwardDirectionalAccuracyGapVsBaseline)</small>
                                        </div>
                                        <div>
                                            <span class="metric-label">Holdout RMSE <InfoTooltip TermKey="rmse" /></span>
                                            <strong>@FormatNullableRmse(modelMetric.HoldoutRmse)</strong>
                                            <small>@FormatNullableSignedRmse(modelMetric.HoldoutRmseGapVsBaseline)</small>
                                        </div>
                                        <div>
                                            <span class="metric-label">Holdout MAE <InfoTooltip TermKey="mae" /></span>
                                            <strong>@FormatNullableRmse(modelMetric.HoldoutMae)</strong>
                                            <small>@FormatNullableSignedRmse(modelMetric.HoldoutMaeGapVsBaseline)</small>
                                        </div>
                                        <div>
                                            <span class="metric-label">Holdout Richtung <InfoTooltip TermKey="directional_accuracy" /></span>
                                            <strong>@FormatNullableRatePercent(modelMetric.HoldoutDirectionalAccuracy)</strong>
                                            <small>Testsplit</small>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(modelMetric.Notes))
                                    {
                                        <p class="model-note">@modelMetric.Notes</p>
                                    }
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="watchlist-empty-copy">Für dieses Asset liegen aktuell keine Vergleichsmetriken im Payload vor.</p>
                    }
                }
            </article>

            <aside class="side-rail">
                @if (rankingEntries.Count > 0)
                {
                    <article class="panel-shell rail-card">
                        <span class="section-kicker">Kurzranking</span>
                        <h3>Prognosequalität im Vergleich</h3>
                        <div class="compact-ranking">
                            @foreach (var entry in rankingEntries.Take(3))
                            {
                                <button class="compact-ranking-row @(entry.Ticker == activeTicker.Ticker ? "is-active" : string.Empty)"
                                        type="button"
                                        @onclick="() => SelectTicker(entry.Ticker)">
                                    <span class="compact-rank">#@entry.Rank</span>
                                    <div>
                                        <strong>@entry.Ticker</strong>
                                        <small>Score @FormatScore(entry.RankingScore)</small>
                                    </div>
                                    <strong class="@GetTrendTone(entry.ForecastHorizonChangePct)">
                                        @FormatPercent(entry.ForecastHorizonChangePct)
                                    </strong>
                                </button>
                            }
                        </div>
                    </article>
                }

                <article class="panel-shell rail-card" id="research-notes">
                    <span class="section-kicker">Methodik</span>
                    <h3>Erklärungen liegen bewusst nicht mehr oben</h3>
                    <p class="rail-copy">
                        RMSE, Baseline, Richtungstreffer und Forschungsgrenzen sind auf der Hinweise-Seite gebündelt,
                        damit die Startseite wie ein kompaktes Finanzdashboard lesbar bleibt.
                    </p>

                    <div class="rail-actions">
                        <a class="action-link action-secondary" href="hinweise">Zu Methodik & Hinweisen</a>
                    </div>

                    @if (payload.Notes.Count > 0)
                    {
                        <ul class="compact-note-list">
                            @foreach (var note in payload.Notes.Take(2))
                            {
                                <li>@note</li>
                            }
                        </ul>
                    }
                </article>

                <article class="panel-shell rail-card" id="notification-settings">
                    <NotificationStatusCard />
                </article>
            </aside>
        </section>

        @if (newsSnapshot?.Items.Count > 0)
        {
            <section class="section-stack" id="news">
                <div class="section-heading">
                    <div>
                        <span class="section-kicker">News-Kontext</span>
                        <h2>Nachrichten als Einordnung, nicht als Handelssignal</h2>
                    </div>
                    <a class="action-link action-secondary" href="news">Alle News</a>
                </div>

                <article class="panel-shell news-brief">
                    <div class="news-brief-callout">
                        <div class="detail-badges">
                            <span class="meta-pill">Quelle: @newsSnapshot.ProviderLabel</span>
                            <span class="meta-pill">@(newsSnapshot.IsDemoData ? "Demo-Daten" : "News-Feed")</span>
                        </div>
                        <p class="rail-copy">@newsSnapshot.ModelUsageNotice</p>
                        <p class="rail-copy">@newsSnapshot.ContextNotice</p>
                    </div>

                    <div class="teaser-grid">
                        @foreach (var item in newsSnapshot.Items)
                        {
                            <article class="panel-shell news-brief-card">
                                <div class="panel-header">
                                    <span class="meta-pill">@item.Category</span>
                                    <span class="meta-pill">@FormatDateTime(item.PublishedAt)</span>
                                </div>
                                <h3>@item.Title</h3>
                                <p class="rail-copy">@item.Source</p>
                                @if (item.AffectedTickers.Count > 0)
                                {
                                    <div class="tag-list">
                                        @foreach (var ticker in item.AffectedTickers)
                                        {
                                            <span class="ticker-tag muted">@ticker</span>
                                        }
                                    </div>
                                }
                                <div class="rail-actions">
                                    <a class="action-link action-secondary"
                                       href="@item.Link"
                                       target="_blank"
                                       rel="noreferrer noopener">
                                        Quellenkontext öffnen
                                    </a>
                                </div>
                            </article>
                        }
                    </div>
                </article>
            </section>
        }

        <section class="section-stack" id="benchmarks">
            <div class="section-heading">
                <div>
                    <span class="section-kicker">Benchmark- und Modellübersicht</span>
                    <h2>Kompakter Forschungsstand statt langer Einführung</h2>
                </div>
                <div class="meta-pill">Thesis-Run @payload.SourceRuns.ThesisRun</div>
            </div>

            <div class="summary-grid">
                <article class="summary-card panel-shell accent-starter">
                    <div class="card-header-row">
                        <span class="section-kicker">Starter-Setup</span>
                        <span class="tone-pill @(GetGapTone(starterSummary.MeanBestLearnedMinusBaselineRmse))">
                            Abstand @FormatSignedRmse(starterSummary.MeanBestLearnedMinusBaselineRmse)
                        </span>
                    </div>
                    <strong class="card-value">@FormatFeatureProfileLabel(starterSummary.FeatureProfile) / @starterSummary.Lags Lags</strong>
                    <p class="card-copy">
                        Dominantes Modell:
                        <span class="metric-label inline-help">
                            @FormatModelLabel(starterSummary.DominantBestModel, starterSummary.DominantBestModelLabel)
                            @if (GetModelExplanationTermKey(starterSummary.DominantBestModel) is { } starterModelTermKey)
                            {
                                <InfoTooltip TermKey="@starterModelTermKey" />
                            }
                        </span>
                    </p>
                    <div class="card-metrics">
                        <span class="metric-label">Beste gelernte RMSE <InfoTooltip TermKey="rmse" /></span>
                        <strong>@FormatRmse(starterSummary.MeanBestLearnedRmse)</strong>
                        <span class="metric-label">Richtung <InfoTooltip TermKey="directional_accuracy" /></span>
                        <strong>@FormatRatePercent(starterSummary.MeanBestLearnedDirectionalAccuracy * 100)</strong>
                    </div>
                </article>

                <article class="summary-card panel-shell accent-core">
                    <div class="card-header-row">
                        <span class="section-kicker">Bachelor Kernkorb</span>
                        <span class="tone-pill @(GetGapTone(coreSummary.MeanBestLearnedMinusBaselineRmse))">
                            @FormatModelLabel(coreSummary.DominantBestModel, coreSummary.DominantBestModelLabel)
                        </span>
                    </div>
                    <strong class="card-value">@FormatFeatureProfileLabel(coreSummary.FeatureProfile)</strong>
                    <p class="card-copy">
                        Bestes Profil über @coreSummary.TickerCount Ticker mit kompakter RMSE-Bewertung.
                    </p>
                    <div class="card-metrics">
                        <span class="metric-label">Gelernte RMSE <InfoTooltip TermKey="rmse" /></span>
                        <strong>@FormatRmse(coreSummary.MeanBestLearnedRmse)</strong>
                        <span class="metric-label">Baseline <InfoTooltip TermKey="persistence_baseline" /></span>
                        <strong>@FormatRmse(coreSummary.MeanWalkForwardBaselineRmse)</strong>
                    </div>
                </article>

                <article class="summary-card panel-shell accent-diversified">
                    <div class="card-header-row">
                        <span class="section-kicker">Diversifizierter Korb</span>
                        <span class="tone-pill @(GetGapTone(diversifiedSummary.MeanBestLearnedMinusBaselineRmse))">
                            @FormatModelLabel(diversifiedSummary.DominantBestModel, diversifiedSummary.DominantBestModelLabel)
                        </span>
                    </div>
                    <strong class="card-value">@FormatFeatureProfileLabel(diversifiedSummary.FeatureProfile)</strong>
                    <p class="card-copy">
                        Breiterer Korb mit @diversifiedSummary.TickerCount Tickern und eigener Profilbewertung.
                    </p>
                    <div class="card-metrics">
                        <span class="metric-label">Gelernte RMSE <InfoTooltip TermKey="rmse" /></span>
                        <strong>@FormatRmse(diversifiedSummary.MeanBestLearnedRmse)</strong>
                        <span class="metric-label">Baseline <InfoTooltip TermKey="persistence_baseline" /></span>
                        <strong>@FormatRmse(diversifiedSummary.MeanWalkForwardBaselineRmse)</strong>
                    </div>
                </article>

                <article class="summary-card panel-shell accent-neutral">
                    <div class="card-header-row">
                        <span class="section-kicker">Baseline-Check</span>
                        <span class="tone-pill @(starterBeaters.Count > 0 ? "tone-positive" : "tone-neutral")">
                            @(starterBeaters.Count > 0 ? "Teilweise besser" : "Noch nicht besser")
                        </span>
                    </div>
                    <strong class="card-value">@starterBeaters.Count / @starterSummary.TickerCount</strong>
                    <p class="card-copy">
                        Starter-Ticker, die die naive Persistence-Baseline bei der Walk-Forward-RMSE schlagen.
                    </p>
                    <div class="card-metrics">
                        <span class="metric-label">Bessere Ticker <InfoTooltip TermKey="persistence_baseline" /></span>
                        <strong>@(starterBeaters.Count > 0 ? string.Join(", ", starterBeaters) : "Noch keine")</strong>
                    </div>
                </article>
            </div>
        </section>

        @if (payload.MultiAssetSummaries.Count > 0)
        {
            <section class="section-stack" id="multi-asset">
                <div class="section-heading">
                    <div>
                        <span class="section-kicker">Gemeinsame Multi-Asset-Läufe</span>
                        <h2>Aktien- und ETF-Körbe aus dem gemeinsamen Modellpfad</h2>
                    </div>
                    <div class="meta-pill">Forschungsblock</div>
                </div>

                <section class="benchmark-grid">
                    @foreach (var summary in payload.MultiAssetSummaries)
                    {
                        <article class="panel-shell benchmark-card">
                            <div class="panel-header">
                                <div>
                                    <span class="section-kicker">@FormatMultiAssetBasketLabel(summary.BasketPreset, summary.BasketLabel)</span>
                                    <h2>@FormatFeatureProfileLabel(summary.FeatureProfile) / @summary.Lags Lags</h2>
                                </div>
                                <span class="tone-pill @(GetGapTone(summary.SharedModelMinusBaselineRmse))">
                                    Abstand @FormatSignedRmse(summary.SharedModelMinusBaselineRmse)
                                </span>
                            </div>

                            <div class="benchmark-metrics">
                                <div>
                                    <span>Gemeinsame RMSE</span>
                                    <strong>@FormatRmse(summary.SharedModelRmse)</strong>
                                </div>
                                <div>
                                    <span>Baseline-RMSE</span>
                                    <strong>@FormatRmse(summary.BaselineRmse)</strong>
                                </div>
                                <div>
                                    <span>Siegermodell</span>
                                    <strong>@FormatModelLabel(summary.SharedModelName, summary.SharedModelLabel)</strong>
                                </div>
                            </div>

                            <div class="detail-stats-grid">
                                <article class="mini-stat">
                                    <span>Richtungstreffer</span>
                                    <strong>@FormatRatePercent(summary.SharedModelDirectionalAccuracy * 100)</strong>
                                    <small>@summary.ExperimentId</small>
                                </article>
                                <article class="mini-stat">
                                    <span>ML-Horizont</span>
                                    <strong>@FormatPercent(summary.MeanForecastHorizonChangePct)</strong>
                                    <small>@summary.TickerCount Assets</small>
                                </article>
                                <article class="mini-stat">
                                    <span>Durchschnittlicher Abstand</span>
                                    <strong>@FormatPlainPercent(summary.MeanAverageForecastDistancePctToLastClose)</strong>
                                    <small>über alle Assets</small>
                                </article>
                                <article class="mini-stat">
                                    <span>Stärkster Forecast</span>
                                    <strong>@summary.TopForecastTicker</strong>
                                    <small>@FormatPercent(summary.TopForecastHorizonChangePct)</small>
                                </article>
                            </div>

                            <div class="tag-list">
                                @foreach (var ticker in summary.Tickers)
                                {
                                    <span class="ticker-tag muted">@ticker</span>
                                }
                            </div>
                        </article>
                    }
                </section>
            </section>
        }

        <section class="section-stack">
            <div class="section-heading">
                <div>
                    <span class="section-kicker">Klassische Benchmark-Körbe</span>
                    <h2>Profilvergleich und Baseline-Abstand im Überblick</h2>
                </div>
            </div>

            <section class="benchmark-grid">
                @foreach (var basket in payload.BasketSummaries)
                {
                    <article class="panel-shell benchmark-card">
                        <div class="panel-header">
                            <div>
                                <span class="section-kicker">@FormatBasketLabel(basket.BasketKey, basket.BasketLabel)</span>
                                <h2>@FormatFeatureProfileLabel(basket.BestProfile) ist in diesem Korb vorne</h2>
                            </div>
                            <span class="tone-pill @(GetGapTone(basket.MeanGapVsBaseline))">
                                Abstand @FormatSignedRmse(basket.MeanGapVsBaseline)
                            </span>
                        </div>

                        <div class="benchmark-metrics">
                            <div>
                                <span>Beste gelernte RMSE</span>
                                <strong>@FormatRmse(basket.MeanBestLearnedRmse)</strong>
                            </div>
                            <div>
                                <span>Baseline-RMSE</span>
                                <strong>@FormatRmse(basket.MeanWalkForwardBaselineRmse)</strong>
                            </div>
                            <div>
                                <span>Dominantes Modell</span>
                                <strong>@FormatModelLabel(basket.DominantBestModel, basket.DominantBestModelLabel)</strong>
                            </div>
                        </div>

                        <div class="profile-balance">
                            <div class="balance-header">
                                <span>Technisch erweitert vorne</span>
                                <strong>@basket.TechnicalExtendedBetterCount</strong>
                            </div>
                            <div class="balance-track">
                                <div class="balance-fill positive" style="width:@GetShare(basket.TechnicalExtendedBetterCount, basket.TechnicalExtendedBetterCount + basket.LagOnlyBetterCount)%;"></div>
                            </div>
                            <div class="balance-header alternate">
                                <span>Nur Lags vorne</span>
                                <strong>@basket.LagOnlyBetterCount</strong>
                            </div>
                        </div>

                        <div class="benchmark-lists">
                            <div>
                                <span class="tag-label">Technisch erweitert besser</span>
                                <div class="tag-list">
                                    @foreach (var ticker in basket.TechnicalExtendedBetterTickers)
                                    {
                                        <span class="ticker-tag positive">@ticker</span>
                                    }
                                </div>
                            </div>
                            <div>
                                <span class="tag-label">Nur Lags besser</span>
                                <div class="tag-list">
                                    @foreach (var ticker in basket.LagOnlyBetterTickers)
                                    {
                                        <span class="ticker-tag muted">@ticker</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </section>
        </section>

        <section class="teaser-grid">
            <article class="panel-shell teaser-card">
                <span class="section-kicker">Hinweise</span>
                <h2>Methodik und Grenzen liegen bewusst außerhalb der Startseite</h2>
                <p>
                    Die Startseite priorisiert Kurse, Watchlist und kompakte Modellbewertung. Die ausführliche Einordnung
                    zu Begriffen, Grenzen und Forschungscharakter liegt gesammelt auf der Hinweise-Seite.
                </p>
                <div class="hero-actions">
                    <a class="action-link action-primary" href="hinweise">Hinweise öffnen</a>
                    <a class="action-link" href="chat">FAQ-Chat öffnen</a>
                </div>
            </article>

            <article class="panel-shell teaser-card">
                <span class="section-kicker">Datenbasis</span>
                <h2>Diese Exporte speisen das Dashboard</h2>
                <div class="run-list">
                    <div>
                        <span>Thesis-Export</span>
                        <strong>@payload.SourceRuns.ThesisRun</strong>
                    </div>
                    <div>
                        <span>Starter-Suite</span>
                        <strong>@payload.SourceRuns.StarterSuite</strong>
                    </div>
                    <div>
                        <span>Core-Vergleich</span>
                        <strong>@payload.SourceRuns.CoreProfileComparison</strong>
                    </div>
                    <div>
                        <span>Diversified-Vergleich</span>
                        <strong>@payload.SourceRuns.DiversifiedProfileComparison</strong>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(payload.SourceRuns.MultiAssetSuiteRun))
                    {
                        <div>
                            <span>Multi-Asset-Suite</span>
                            <strong>@payload.SourceRuns.MultiAssetSuiteRun</strong>
                        </div>
                    }
                </div>
            </article>

            <article class="panel-shell teaser-card">
                <span class="section-kicker">Zukunftsthemen</span>
                <h2>Profile und Integrationen bleiben bewusst noch deaktiviert</h2>
                <p>
                    Der aktuelle Stand ist ein Forschungs- und Demonstrationssystem. Es gibt weder automatisches
                    Trading noch Broker-Orders oder echte TradingView-Signale.
                </p>
                <div class="tag-list">
                    <span class="meta-pill planned-pill">Profile: geplant</span>
                    <span class="meta-pill planned-pill">TradingView-Export: geplant</span>
                    <span class="meta-pill planned-pill">Broker-Anbindung: Zukunftsthema</span>
                </div>
                <p class="teaser-note">
                    ML-Ergebnisse dienen hier nur der Einordnung im Rahmen der Bachelorarbeit und sind keine Anlageberatung.
                </p>
            </article>
        </section>
    </div>
}

@code {
    private static readonly CultureInfo UiCulture = CultureInfo.GetCultureInfo("de-DE");

    private DashboardDataSnapshot? _snapshot;
    private NewsFeedSnapshot? _newsSnapshot;
    private IReadOnlyList<AssetCatalogEntry> _assetEntries = [];
    private List<string> _watchlistTickers = [];
    private string? _selectedTickerSymbol;
    private string _assetSearchQuery = string.Empty;
    private DashboardSurfaceMode _activeSurfaceMode = DashboardSurfaceMode.PricesOnly;
    private bool _notificationCheckPending;
    private bool _isLoading = true;
    private bool _watchlistLoaded;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardSnapshotAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_watchlistLoaded)
        {
            await LoadWatchlistAsync();
        }

        if (_notificationCheckPending && _snapshot?.Payload is not null)
        {
            _notificationCheckPending = false;
            await NotificationService.CheckForPayloadUpdatesAsync(_snapshot.Payload, _watchlistTickers);
        }
    }

    private async Task ReloadDashboardAsync()
    {
        _isLoading = true;
        await LoadDashboardSnapshotAsync();
    }

    private async Task LoadDashboardSnapshotAsync()
    {
        _snapshot = await DashboardDataService.GetLatestAsync();
        _newsSnapshot = await NewsService.GetSnapshotAsync(new NewsQuery
        {
            MaxItems = 4
        });
        _assetEntries = _snapshot.Payload is not null
            ? AssetCatalogService.BuildEntries(_snapshot.Payload)
            : [];

        if (_snapshot.Payload?.FeaturedTickers.Count > 0)
        {
            _selectedTickerSymbol = _snapshot.Payload.FeaturedTickers
                .FirstOrDefault(ticker => ticker.Ticker == _selectedTickerSymbol)
                ?.Ticker
                ?? _snapshot.Payload.FeaturedTickers[0].Ticker;
        }
        else
        {
            _selectedTickerSymbol = null;
        }

        _notificationCheckPending = _snapshot.Payload is not null;
        _isLoading = false;
    }

    private async Task LoadWatchlistAsync()
    {
        try
        {
            _watchlistTickers = (await BrowserWatchlistService.GetAsync()).ToList();
        }
        catch (InvalidOperationException)
        {
            _watchlistTickers = [];
        }
        catch (JSDisconnectedException)
        {
            _watchlistTickers = [];
        }
        finally
        {
            _watchlistLoaded = true;
        }

        _notificationCheckPending = _snapshot?.Payload is not null;
        await InvokeAsync(StateHasChanged);
    }

    private void SelectTicker(string tickerSymbol)
    {
        _selectedTickerSymbol = tickerSymbol;
    }

    private void SetSurfaceMode(DashboardSurfaceMode mode)
    {
        _activeSurfaceMode = mode;
    }

    private async Task HandleAssetSearchSubmit()
    {
        var targetTicker = GetSearchTargetTicker();

        if (!string.IsNullOrWhiteSpace(targetTicker))
        {
            OpenAsset(targetTicker);
        }

        await Task.CompletedTask;
    }

    private void ClearAssetSearch()
    {
        _assetSearchQuery = string.Empty;
    }

    private void OpenAsset(string tickerSymbol)
    {
        NavigationManager.NavigateTo(GetAssetHref(tickerSymbol));
    }

    private string GetAssetHref(string tickerSymbol)
    {
        return $"/assets/{Uri.EscapeDataString(AssetCatalogService.NormalizeTicker(tickerSymbol))}";
    }

    private string? GetSearchTargetTicker()
    {
        if (string.IsNullOrWhiteSpace(_assetSearchQuery))
        {
            return null;
        }

        var normalizedTicker = AssetCatalogService.NormalizeTicker(_assetSearchQuery);
        var exactMatch = _assetEntries.FirstOrDefault(entry =>
            string.Equals(entry.Ticker, normalizedTicker, StringComparison.OrdinalIgnoreCase));

        if (exactMatch is not null)
        {
            return exactMatch.Ticker;
        }

        return AssetCatalogService.Search(_assetEntries, _assetSearchQuery).FirstOrDefault()?.Ticker ?? normalizedTicker;
    }

    private async Task ToggleWatchlistAsync(string tickerSymbol)
    {
        var normalizedTicker = AssetCatalogService.NormalizeTicker(tickerSymbol);

        if (IsInWatchlist(normalizedTicker))
        {
            _watchlistTickers = _watchlistTickers
                .Where(existingTicker => !string.Equals(existingTicker, normalizedTicker, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        else
        {
            _watchlistTickers.Add(normalizedTicker);
        }

        try
        {
            await BrowserWatchlistService.SaveAsync(_watchlistTickers);
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSDisconnectedException)
        {
        }

        _notificationCheckPending = _snapshot?.Payload is not null;
    }

    private bool IsInWatchlist(string tickerSymbol)
    {
        return _watchlistTickers.Any(existingTicker =>
            string.Equals(existingTicker, tickerSymbol, StringComparison.OrdinalIgnoreCase));
    }

    private string GetWatchlistButtonLabel(string tickerSymbol)
    {
        return IsInWatchlist(tickerSymbol) ? "Aus Watchlist entfernen" : "Zur Watchlist hinzufügen";
    }

