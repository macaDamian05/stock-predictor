    private static string GetDominantForecastModelLabel(DashboardPayload payload)
    {
        if (payload.FeaturedTickers.Count == 0)
        {
            return "n/a";
        }

        var dominantModel = payload.FeaturedTickers
            .GroupBy(ticker => new { ticker.ForecastModel, ticker.ForecastModelLabel })
            .OrderByDescending(group => group.Count())
            .First();

        return FormatModelLabel(dominantModel.Key.ForecastModel, dominantModel.Key.ForecastModelLabel);
    }

    private static string? GetDominantForecastModelExplanationTermKey(DashboardPayload payload)
    {
        if (payload.FeaturedTickers.Count == 0)
        {
            return null;
        }

        var dominantModel = payload.FeaturedTickers
            .GroupBy(ticker => ticker.ForecastModel)
            .OrderByDescending(group => group.Count())
            .First();

        return GetModelExplanationTermKey(dominantModel.Key);
    }

