    private static string? GetModelExplanationTermKey(string? primaryModelKey, string? fallbackModelKey = null)
    {
        var modelKey = !string.IsNullOrWhiteSpace(primaryModelKey)
            ? primaryModelKey
            : fallbackModelKey;

        return modelKey switch
        {
            "baseline_persistence" => "persistence_baseline",
            "random_forest" => "random_forest",
            "decision_tree" => "decision_tree",
            "ridge_regression" => "ridge_regression",
            "lstm" => "lstm",
            _ => null
        };
    }

    private static bool IsTickerStale(DashboardPayload payload, FeaturedTicker ticker)
    {
        var staleAfterDays = payload.StaleAfterDays > 0 ? payload.StaleAfterDays : 3;
        var today = DateOnly.FromDateTime(DateTime.Now);
        var dataUntil = GetDataUntil(payload, ticker) ?? ticker.LastCloseDate;
        var dataAgeDays = today.DayNumber - dataUntil.DayNumber;
        var forecastGeneratedAt = GetForecastGeneratedAt(payload, ticker);
        var forecastAgeDays = Math.Max(0, (DateTime.Now.Date - forecastGeneratedAt.Date).Days);

        return dataAgeDays > staleAfterDays || forecastAgeDays > staleAfterDays;
    }

    private static string GetFreshnessLabel(DashboardPayload payload, FeaturedTicker ticker)
    {
        return IsTickerStale(payload, ticker)
            ? "Älterer Export"
            : "Aktueller Export";
    }

    private static string GetPayloadFreshnessLabel(DashboardPayload payload)
    {
        var staleAfterDays = payload.StaleAfterDays > 0 ? payload.StaleAfterDays : 3;
        if (payload.DataUntil is null)
        {
            var exportAgeDays = Math.Max(0, (DateTime.Now.Date - payload.GeneratedAt.Date).Days);
            return exportAgeDays > staleAfterDays
                ? $"Export älter als {staleAfterDays} Tage"
                : "Export aktuell";
        }

        var today = DateOnly.FromDateTime(DateTime.Now);
        var dataAgeDays = today.DayNumber - payload.DataUntil.Value.DayNumber;
        return dataAgeDays > staleAfterDays
            ? $"Älter als {staleAfterDays} Tage"
            : "Lokal aktuell";
    }

