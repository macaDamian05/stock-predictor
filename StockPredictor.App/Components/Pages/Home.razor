    }

    private bool IsAssetForecastStale(AssetCatalogEntry asset)
    {
        if (asset.FeaturedTicker is null || _snapshot?.Payload is null)
        {
            return false;
        }

        var staleAfterDays = _snapshot.Payload.StaleAfterDays > 0 ? _snapshot.Payload.StaleAfterDays : 3;
        var dataUntil = asset.FeaturedTicker.DataUntil ?? _snapshot.Payload.DataUntil ?? asset.FeaturedTicker.LastCloseDate;
        var forecastGeneratedAt = asset.FeaturedTicker.ForecastGeneratedAt ?? _snapshot.Payload.GeneratedAt;
        var today = DateOnly.FromDateTime(DateTime.Now);
        var dataAgeDays = today.DayNumber - dataUntil.DayNumber;
        var forecastAgeDays = Math.Max(0, (DateTime.Now.Date - forecastGeneratedAt.Date).Days);
        return dataAgeDays > staleAfterDays || forecastAgeDays > staleAfterDays;
    }

    private DateTime? GetNewestMarketTimestamp(IEnumerable<AssetCatalogEntry> entries)
    {
        return entries
            .Select(entry => GetMarketSnapshot(entry.Ticker)?.LastPoint?.Timestamp)
            .Where(timestamp => timestamp is not null)
            .Max();
    }

    private string FormatRangePercent(string ticker, MarketTimeRange range)
    {
        if (GetRangeChanges(ticker).TryGetValue(range, out var change))
        {
            return FormatPercent(change.PercentChange);
        }

        return "n/a";
    }

    private string GetRangeTone(string ticker, MarketTimeRange range)
    {
        if (GetRangeChanges(ticker).TryGetValue(range, out var change))
        {
            return GetTrendTone(change.PercentChange);
        }

        return "tone-neutral";
    }

    private static string GetForecastAvailabilityTone(AssetCatalogEntry entry)
    {
        if (entry.ForecastAvailable)
        {
            return "tone-positive";
        }

        return entry.HasPreparedPayloadData ? "tone-neutral" : "tone-negative";
    }

    private static string GetForecastAvailabilityLabel(AssetCatalogEntry entry)
    {
        if (entry.ForecastAvailable)
        {
            return "Forecast verfügbar";
        }

        return entry.HasPreparedPayloadData ? "Payload vorhanden" : "Noch kein Forecast";
    }

    private static string GetPayloadFreshnessLabel(DashboardPayload payload)
    {
        var staleAfterDays = payload.StaleAfterDays > 0 ? payload.StaleAfterDays : 3;
        if (payload.DataUntil is null)
        {
            var exportAgeDays = Math.Max(0, (DateTime.Now.Date - payload.GeneratedAt.Date).Days);
            return exportAgeDays > staleAfterDays ? $"Export älter als {staleAfterDays} Tage" : "Export aktuell";
        }

        var today = DateOnly.FromDateTime(DateTime.Now);
        var dataAgeDays = today.DayNumber - payload.DataUntil.Value.DayNumber;
        return dataAgeDays > staleAfterDays ? $"Älter als {staleAfterDays} Tage" : "Lokal aktuell";
    }

    private static string FormatDate(DateOnly date) => date.ToString("dd. MMM yyyy", UiCulture);

    private static string FormatNullableDate(DateOnly? date) => date is null ? "n/a" : FormatDate(date.Value);

    private static string FormatDateTime(DateTime dateTime) => dateTime.ToString("dd. MMM yyyy | HH:mm", UiCulture);

    private static string FormatTimestamp(DateTime? value) => value is null ? "n/a" : value.Value.ToString("dd. MMM yyyy | HH:mm", UiCulture);

    private static string FormatNullablePrice(double? value) => value is null ? "n/a" : value.Value.ToString("N2", UiCulture);

    private static string FormatRmse(double value) => value.ToString("0.000", UiCulture);

    private static string FormatPercent(double value) => $"{(value >= 0 ? "+" : string.Empty)}{value.ToString("0.00", UiCulture)}%";

    private static string FormatRatePercent(double value) => $"{value.ToString("0.00", UiCulture)}%";

    private static string FormatModelLabel(string rawValue, string fallback)
    {
        return rawValue switch
        {
            "baseline_persistence" => "Persistence-Baseline",
            "random_forest" => "Random Forest",
            "ridge_regression" => "Ridge-Regression",
            "decision_tree" => "Entscheidungsbaum",
            "lstm" => "LSTM",
            _ when !string.IsNullOrWhiteSpace(rawValue) => rawValue.Replace("_", " "),
            _ => fallback,
        };
    }

    private static string FormatFeatureProfileLabel(string rawValue)
    {
        return rawValue switch
        {
            "technical_extended" => "Technisch erweitert",
            "technical_basic" => "Technisch grundlegend",
            "lag_only" => "Nur Lags",
            _ => rawValue.Replace("_", " "),
        };
    }

    private static string GetTrendTone(double value)
    {
        return value switch
        {
            > 0.01 => "tone-positive",
            < -0.01 => "tone-negative",
            _ => "tone-neutral",
        };
    }

    private void HandleJobsChanged()
    {
        _ = InvokeAsync(async () =>
        {
            foreach (var job in ForecastJobService.GetJobs().Where(job =>
                         job.State is (ForecastJobState.Completed or ForecastJobState.Failed)
                         && job.CompletedAt >= DateTime.Now.AddMinutes(-2)))
            {
                await NotificationService.NotifyForecastJobChangedAsync(job);
            }

            var completedRecently = ForecastJobService.GetJobs().Any(job =>
                job.State == ForecastJobState.Completed
                && job.CompletedAt >= DateTime.Now.AddMinutes(-2));

            if (completedRecently && !_reloadingAfterJob)
            {
                _reloadingAfterJob = true;
                try
                {
                    await LoadHomeAsync();
                }
                finally
                {
                    _reloadingAfterJob = false;
                }
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ForecastJobService.JobsChanged -= HandleJobsChanged;
    }
}
