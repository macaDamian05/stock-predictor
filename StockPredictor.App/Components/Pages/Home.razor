    {
        return AssetCatalogService.Search(_assetEntries, _assetSearchQuery);
    }

    private IReadOnlyList<AssetCatalogEntry> GetWatchlistEntries()
    {
        var entriesByTicker = _assetEntries.ToDictionary(entry => entry.Ticker, StringComparer.OrdinalIgnoreCase);
        var watchlistEntries = new List<AssetCatalogEntry>(_watchlistTickers.Count);

        foreach (var ticker in _watchlistTickers)
        {
            if (entriesByTicker.TryGetValue(ticker, out var entry))
            {
                watchlistEntries.Add(entry);
            }
            else
            {
                watchlistEntries.Add(AssetCatalogService.CreatePlaceholderEntry(ticker));
            }
        }

        return watchlistEntries;
    }

