@page "/"
@using System.Globalization
@inject DashboardDataService DashboardDataService

<PageTitle>Stock-Predictor-Dashboard</PageTitle>

@if (_isLoading)
{
    <section class="dashboard-empty panel-shell">
        <span class="section-kicker">Laden</span>
        <h1>Dashboard wird aufgebaut…</h1>
        <p>Die App lädt den neuesten Dashboard-Payload aus der ML-Pipeline.</p>
    </section>
}
else if (_snapshot?.Payload is null)
{
    <section class="dashboard-empty panel-shell">
        <span class="section-kicker">Payload fehlt</span>
        <h1>Noch keine Dashboard-Daten gefunden</h1>
        <p>@(_snapshot?.ErrorMessage ?? "Der Dashboard-Payload konnte nicht geladen werden.")</p>
        <div class="empty-state-meta">
            <span class="meta-pill">Erwartete Datei</span>
            <code>@_snapshot?.ResolvedPath</code>
        </div>
        <div class="empty-state-command">
            <span class="meta-pill">Erzeugen mit</span>
            <code>.\StockPredictor.ML\.venv\Scripts\python.exe StockPredictor.ML\export_dashboard_payload.py</code>
        </div>
    </section>
}
else
{
    var payload = _snapshot.Payload;
    var activeTicker = GetActiveTicker(payload);
    var starterSummary = payload.SummaryCards.StarterBestExperiment;
    var coreSummary = payload.SummaryCards.BestCoreProfile;
    var diversifiedSummary = payload.SummaryCards.BestDiversifiedProfile;
    var starterBeaters = payload.SummaryCards.StarterTickersBeatingBaseline;
    var activeRanking = GetActiveRankingEntry(payload, activeTicker.Ticker);

    <div class="dashboard-page">
        <section class="hero-shell panel-shell" id="overview">
            <div class="hero-copy">
                <span class="section-kicker">Forschungs-Dashboard</span>
                <h1>Aktienprognosen, Benchmarks und 5-Tage-Ausblicke in einem dunklen Dashboard.</h1>
                <p>
                    Diese Oberfläche liest den neuesten Thesis-Export und macht daraus ein Dashboard, das du direkt auswerten kannst:
                    Benchmark-Körbe, ausgewählte Ticker, Prognosepfade und der aktuelle Abstand zur Baseline.
                </p>
            </div>

            <div class="hero-meta">
                <div class="meta-pill">Erstellt @FormatDateTime(payload.GeneratedAt)</div>
                <div class="meta-pill">Schema v@payload.UiContractVersion</div>
                <div class="meta-pill">Quelle: Thesis-Run @payload.SourceRuns.ThesisRun</div>
            </div>
        </section>

        <section class="summary-grid">
            <article class="summary-card panel-shell accent-starter">
                <div class="card-header-row">
                    <span class="section-kicker">Bestes Starter-Setup</span>
                    <span class="tone-pill @(GetGapTone(starterSummary.MeanBestLearnedMinusBaselineRmse))">
                        Abstand @FormatSignedRmse(starterSummary.MeanBestLearnedMinusBaselineRmse)
                    </span>
                </div>
                <strong class="card-value">@FormatFeatureProfileLabel(starterSummary.FeatureProfile) / @starterSummary.Lags Lags</strong>
                <p class="card-copy">
                    Dominantes Modell: @FormatModelLabel(starterSummary.DominantBestModel, starterSummary.DominantBestModelLabel).
                    Mittlere Richtungstrefferquote @FormatPercent(starterSummary.MeanBestLearnedDirectionalAccuracy * 100).
                </p>
                <div class="card-metrics">
                    <span>Beste gelernte RMSE <strong>@FormatRmse(starterSummary.MeanBestLearnedRmse)</strong></span>
                    <span>Baseline-RMSE <strong>@FormatRmse(starterSummary.MeanWalkForwardBaselineRmse)</strong></span>
                </div>
            </article>

            <article class="summary-card panel-shell accent-core">
                <div class="card-header-row">
                    <span class="section-kicker">Bachelor Kernkorb</span>
                    <span class="tone-pill @(GetGapTone(coreSummary.MeanBestLearnedMinusBaselineRmse))">
                        @FormatModelLabel(coreSummary.DominantBestModel, coreSummary.DominantBestModelLabel)
                    </span>
                </div>
                <strong class="card-value">@FormatFeatureProfileLabel(coreSummary.FeatureProfile)</strong>
                <p class="card-copy">
                    Bestes Profil über @coreSummary.TickerCount Ticker. Mittlere gelernte RMSE
                    @FormatRmse(coreSummary.MeanBestLearnedRmse).
                </p>
                <div class="card-metrics">
                    <span>Baseline @FormatRmse(coreSummary.MeanWalkForwardBaselineRmse)</span>
                    <span>Richtung @FormatPercent(coreSummary.MeanBestLearnedDirectionalAccuracy * 100)</span>
                </div>
            </article>

            <article class="summary-card panel-shell accent-diversified">
                <div class="card-header-row">
                    <span class="section-kicker">Diversifizierter Korb</span>
                    <span class="tone-pill @(GetGapTone(diversifiedSummary.MeanBestLearnedMinusBaselineRmse))">
                        @FormatModelLabel(diversifiedSummary.DominantBestModel, diversifiedSummary.DominantBestModelLabel)
                    </span>
                </div>
                <strong class="card-value">@FormatFeatureProfileLabel(diversifiedSummary.FeatureProfile)</strong>
                <p class="card-copy">
                    Breiterer Korb mit @diversifiedSummary.TickerCount Tickern. Mittlere gelernte RMSE
                    @FormatRmse(diversifiedSummary.MeanBestLearnedRmse).
                </p>
                <div class="card-metrics">
                    <span>Baseline @FormatRmse(diversifiedSummary.MeanWalkForwardBaselineRmse)</span>
                    <span>Richtung @FormatPercent(diversifiedSummary.MeanBestLearnedDirectionalAccuracy * 100)</span>
                </div>
            </article>

            <article class="summary-card panel-shell accent-neutral">
                <div class="card-header-row">
                    <span class="section-kicker">Baseline-Vergleich</span>
                    <span class="tone-pill @(starterBeaters.Count > 0 ? "tone-positive" : "tone-neutral")">
                        @(starterBeaters.Count > 0 ? "Teilweise besser" : "Noch nicht besser")
                    </span>
                </div>
                <strong class="card-value">@starterBeaters.Count / @starterSummary.TickerCount</strong>
                <p class="card-copy">
                    Starter-Ticker, die die naive Persistence-Baseline bei der Walk-Forward-RMSE schlagen.
                </p>
                <div class="card-metrics">
                    <span>Bessere Ticker</span>
                    <strong>@(starterBeaters.Count > 0 ? string.Join(", ", starterBeaters) : "Noch keine")</strong>
                </div>
            </article>
        </section>

        @if (payload.CompanyRanking.Count > 0)
        {
            <section class="company-ranking panel-shell" id="company-ranking">
                <div class="panel-header">
                    <div>
                        <span class="section-kicker">Unternehmensranking</span>
                        <h2>Mehrere Aktien gleichzeitig vergleichen und nach Prognosequalitaet ordnen</h2>
                    </div>
                    <div class="meta-pill">5 Tage Ausblick + relative Walk-Forward-Guete</div>
                </div>

                <div class="ranking-list">
                    @foreach (var rankingEntry in payload.CompanyRanking)
                    {
                        <button class="ranking-row @(rankingEntry.Ticker == activeTicker.Ticker ? "is-active" : string.Empty)"
                                type="button"
                                @onclick="() => SelectTicker(rankingEntry.Ticker)">
                            <div class="ranking-rank">#@rankingEntry.Rank</div>

                            <div class="ranking-main">
                                <div class="ticker-card-row">
                                    <strong>@rankingEntry.Ticker</strong>
                                    <span class="tone-pill @(GetTrendTone(rankingEntry.ForecastHorizonChangePct))">
                                        5T @FormatPercent(rankingEntry.ForecastHorizonChangePct)
                                    </span>
                                </div>
                                <p class="ranking-copy">
                                    Score @FormatScore(rankingEntry.RankingScore),
                                    Richtung @FormatPlainPercent(rankingEntry.WalkForwardBestDirectionalAccuracy * 100),
                                    relative RMSE @FormatPlainPercent(rankingEntry.RelativeRmsePct),
                                    Ø Abstand @FormatPrice(rankingEntry.AverageForecastDistanceToLastClose)
                                    (@FormatPlainPercent(rankingEntry.AverageForecastDistancePctToLastClose)),
                                    RSI @rankingEntry.AverageRecentRsi.ToString("0.0", UiCulture).
                                </p>
                            </div>

                            <div class="ranking-metrics">
                                <span>
                                    Modell
                                    <strong class="ranking-value">@FormatModelLabel(rankingEntry.ForecastModel, rankingEntry.ForecastModelLabel)</strong>
                                </span>
                                <span>
                                    Profil
                                    <strong class="ranking-value">@FormatFeatureProfileLabel(rankingEntry.FeatureProfile)</strong>
                                </span>
                                <span>
                                    Baseline
                                    <strong class="@GetGapTone(rankingEntry.RelativeGapVsBaselinePct)">
                                        @FormatPercent(rankingEntry.RelativeGapVsBaselinePct)
                                    </strong>
                                </span>
                            </div>
                        </button>
                    }
                </div>
            </section>
        }

        @if (payload.MultiAssetSummaries.Count > 0)
        {
            <section class="benchmark-grid" id="multi-asset">
                @foreach (var summary in payload.MultiAssetSummaries)
                {
                    <article class="panel-shell benchmark-card">
                        <div class="panel-header">
                            <div>
                                <span class="section-kicker">Gemeinsames Multi-Asset-Training</span>
                                <h2>@FormatMultiAssetBasketLabel(summary.BasketPreset, summary.BasketLabel)</h2>
                            </div>
                            <span class="tone-pill @(GetGapTone(summary.SharedModelMinusBaselineRmse))">
                                Abstand @FormatSignedRmse(summary.SharedModelMinusBaselineRmse)
                            </span>
                        </div>

                        <p class="ranking-copy">
                            Beste gefundene Suite-Konfiguration: @FormatFeatureProfileLabel(summary.FeatureProfile) mit
                            @summary.Lags Lags. Gemeinsames Modell: @FormatModelLabel(summary.SharedModelName, summary.SharedModelLabel).
                        </p>

                        <div class="benchmark-metrics">
                            <div>
                                <span>Gemeinsame RMSE</span>
                                <strong>@FormatRmse(summary.SharedModelRmse)</strong>
                            </div>
                            <div>
                                <span>Baseline-RMSE</span>
                                <strong>@FormatRmse(summary.BaselineRmse)</strong>
                            </div>
                            <div>
                                <span>Richtungstreffer</span>
                                <strong>@FormatPercent(summary.SharedModelDirectionalAccuracy * 100)</strong>
                            </div>
                        </div>

                        <div class="detail-stats-grid">
                            <article class="mini-stat">
                                <span>Bestes Setup</span>
                                <strong>@FormatFeatureProfileLabel(summary.FeatureProfile) / @summary.Lags Lags</strong>
                                <small>@summary.ExperimentId</small>
                            </article>
                            <article class="mini-stat">
                                <span>Ø 5-Tage-Ausblick</span>
                                <strong>@FormatPercent(summary.MeanForecastHorizonChangePct)</strong>
                                <small>@summary.TickerCount Assets</small>
                            </article>
                            <article class="mini-stat">
                                <span>Ø Abstand zum letzten Schlusskurs</span>
                                <strong>@FormatPlainPercent(summary.MeanAverageForecastDistancePctToLastClose)</strong>
                                <small>ueber alle Assets</small>
                            </article>
                            <article class="mini-stat">
                                <span>Staerkster Forecast</span>
                                <strong>@summary.TopForecastTicker</strong>
                                <small>@FormatPercent(summary.TopForecastHorizonChangePct)</small>
                            </article>
                        </div>

                        <div>
                            <span class="tag-label">Assets im Korb</span>
                            <div class="tag-list">
                                @foreach (var ticker in summary.Tickers)
                                {
                                    <span class="ticker-tag muted">@ticker</span>
                                }
                            </div>
                        </div>
                    </article>
                }
            </section>
        }

        <section class="workspace-grid" id="ticker-lab">
            <article class="ticker-lab panel-shell">
                <div class="panel-header">
                    <div>
                        <span class="section-kicker">Ausgewählte Ticker</span>
                        <h2>Aktuelle Prognosekandidaten im Vergleich</h2>
                    </div>
                    <div class="meta-pill">Payload-Quelle: @Path.GetFileName(_snapshot.ResolvedPath)</div>
                </div>

                <div class="ticker-lab-grid">
                    <div class="ticker-selector">
                        @foreach (var ticker in payload.FeaturedTickers)
                        {
                            <button class="ticker-card @(ticker.Ticker == activeTicker.Ticker ? "is-active" : string.Empty)"
                                    type="button"
                                    @onclick="() => SelectTicker(ticker.Ticker)">
                                <div class="ticker-card-row">
                                    <strong>@ticker.Ticker</strong>
                                    <span class="tone-pill @(GetTrendTone(ticker.ForecastHorizonChangePct))">
                                        @FormatPercent(ticker.ForecastHorizonChangePct)
                                    </span>
                                </div>
                                <span class="ticker-card-model">
                                    @FormatModelLabel(ticker.ForecastModel, ticker.ForecastModelLabel) /
                                    @FormatFeatureProfileLabel(ticker.FeatureProfile)
                                </span>
                                <div class="ticker-card-row muted">
                                    <span>RMSE @FormatRmse(ticker.WalkForwardBestRmse)</span>
                                    <span>RSI @ticker.AverageRecentRsi.ToString("0.0", UiCulture)</span>
                                </div>
                            </button>
                        }
                    </div>

                    <div class="ticker-detail">
                        <div class="detail-hero">
                            <div>
                                <div class="detail-title-row">
                                    <h2>@activeTicker.Ticker</h2>
                                    <span class="tone-pill @(GetTrendTone(activeTicker.ForecastHorizonChangePct))">
                                        5T @FormatPercent(activeTicker.ForecastHorizonChangePct)
                                    </span>
                                </div>
                                <p>
                                    Prognose mit @FormatModelLabel(activeTicker.ForecastModel, activeTicker.ForecastModelLabel)
                                    auf Basis von @FormatFeatureProfileLabel(activeTicker.FeatureProfile).
                                    Datenfenster: @FormatDate(activeTicker.DataStart) bis @FormatDate(activeTicker.DataEnd).
                                </p>
                            </div>
                            <div class="detail-badges">
                                @if (activeRanking is not null)
                                {
                                    <span class="meta-pill">Ranking: Platz @activeRanking.Rank / Score @FormatScore(activeRanking.RankingScore)</span>
                                }
                                <span class="meta-pill">Holdout-Sieger: @FormatModelLabel(activeTicker.HoldoutBestModel, activeTicker.ForecastModelLabel)</span>
                                <span class="meta-pill">Walk-Forward-Sieger: @FormatModelLabel(activeTicker.WalkForwardBestModel, activeTicker.ForecastModelLabel)</span>
                            </div>
                        </div>

                        <div class="detail-stats-grid">
                            <article class="mini-stat">
                                <span>Letzter Schlusskurs</span>
                                <strong>@FormatPrice(activeTicker.LastClose)</strong>
                                <small>@FormatDate(activeTicker.LastCloseDate)</small>
                            </article>
                            <article class="mini-stat">
                                <span>Nächste Prognose</span>
                                <strong>@FormatPrice(activeTicker.NextPredictedClose)</strong>
                                <small>@FormatPercent(activeTicker.NextPredictedChangePct)</small>
                            </article>
                            <article class="mini-stat">
                                <span>Richtungstreffer</span>
                                <strong>@FormatPercent(activeTicker.WalkForwardBestDirectionalAccuracy * 100)</strong>
                                <small>Walk-Forward</small>
                            </article>
                            <article class="mini-stat">
                                <span>Ø Abstand zum letzten Schlusskurs</span>
                                <strong>@FormatPrice(activeTicker.AverageForecastDistanceToLastClose)</strong>
                                <small>@FormatPlainPercent(activeTicker.AverageForecastDistancePctToLastClose)</small>
                            </article>
                            <article class="mini-stat">
                                <span>Abstand zur Baseline</span>
                                <strong class="@GetGapTone(activeTicker.WalkForwardBestRmse - activeTicker.WalkForwardBaselineRmse)">
                                    @FormatSignedRmse(activeTicker.WalkForwardBestRmse - activeTicker.WalkForwardBaselineRmse)
                                </strong>
                                <small>@(activeTicker.BeatsBaselineRmse ? "Besser als Baseline" : "Baseline weiter stärker")</small>
                            </article>
                        </div>

                        <div class="forecast-panel">
                            <div class="forecast-panel-header">
                                <div>
                                    <span class="section-kicker">5-Tage-Pfad</span>
                                    <h3>Prognostizierter Schlusskursverlauf</h3>
                                </div>
                                <div class="forecast-legend">
                                    <span class="legend-dot"></span>
                                    <span>Letzter Schlusskurs + Prognosepfad</span>
                                </div>
                            </div>
                            <ForecastSparkline Values="@GetSparklineValues(activeTicker)"
                                               TrendTone="@MapToneToSparkline(activeTicker.ForecastHorizonChangePct)"
                                               AriaLabel="@($"{activeTicker.Ticker} Prognosepfad")" />
                        </div>

                        <div class="forecast-strip">
                            @foreach (var point in activeTicker.ForecastPath)
                            {
                                <article class="forecast-day">
                                    <span>@FormatDate(point.Date)</span>
                                    <strong>@FormatPrice(point.PredictedClose)</strong>
                                    <small class="@GetTrendTone(point.PredictedReturn * 100)">@FormatPercent(point.PredictedReturn * 100)</small>
                                </article>
                            }
                        </div>
                    </div>
                </div>
            </article>

            <aside class="insight-rail">
                <article class="panel-shell rail-card">
                    <span class="section-kicker">Pipeline-Kontext</span>
                    <h3>Diese Läufe speisen das Dashboard</h3>
                    <div class="run-list">
                        <div>
                            <span>Thesis-Export</span>
                            <strong>@payload.SourceRuns.ThesisRun</strong>
                        </div>
                        <div>
                            <span>Starter-Suite</span>
                            <strong>@payload.SourceRuns.StarterSuite</strong>
                        </div>
                        <div>
                            <span>Core-Vergleich</span>
                            <strong>@payload.SourceRuns.CoreProfileComparison</strong>
                        </div>
                        <div>
                            <span>Diversified-Vergleich</span>
                            <strong>@payload.SourceRuns.DiversifiedProfileComparison</strong>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(payload.SourceRuns.MultiAssetSuiteRun))
                        {
                            <div>
                                <span>Multi-Asset-Suite</span>
                                <strong>@payload.SourceRuns.MultiAssetSuiteRun</strong>
                            </div>
                        }
                    </div>
                </article>

                <article class="panel-shell rail-card" id="notes">
                    <span class="section-kicker">Forschungsnotizen</span>
                    <h3>Aktuelle Erkenntnisse</h3>
                    <ul class="note-list">
                        @foreach (var note in payload.Notes)
                        {
                            <li>@note</li>
                        }
                    </ul>
                </article>
            </aside>
        </section>

        <section class="benchmark-grid" id="benchmarks">
            @foreach (var basket in payload.BasketSummaries)
            {
                <article class="panel-shell benchmark-card">
                    <div class="panel-header">
                        <div>
                            <span class="section-kicker">@FormatBasketLabel(basket.BasketKey, basket.BasketLabel)</span>
                            <h2>@FormatFeatureProfileLabel(basket.BestProfile) ist in diesem Korb vorne</h2>
                        </div>
                        <span class="tone-pill @(GetGapTone(basket.MeanGapVsBaseline))">
                            Abstand @FormatSignedRmse(basket.MeanGapVsBaseline)
                        </span>
                    </div>

                    <div class="benchmark-metrics">
                        <div>
                            <span>Beste gelernte RMSE</span>
                            <strong>@FormatRmse(basket.MeanBestLearnedRmse)</strong>
                        </div>
                        <div>
                            <span>Baseline-RMSE</span>
                            <strong>@FormatRmse(basket.MeanWalkForwardBaselineRmse)</strong>
                        </div>
                        <div>
                            <span>Dominantes Modell</span>
                            <strong>@FormatModelLabel(basket.DominantBestModel, basket.DominantBestModelLabel)</strong>
                        </div>
                    </div>

                    <div class="profile-balance">
                        <div class="balance-header">
                            <span>Technisch erweitert vorne</span>
                            <strong>@basket.TechnicalExtendedBetterCount</strong>
                        </div>
                        <div class="balance-track">
                            <div class="balance-fill positive" style="width:@GetShare(basket.TechnicalExtendedBetterCount, basket.TechnicalExtendedBetterCount + basket.LagOnlyBetterCount)%;"></div>
                        </div>
                        <div class="balance-header alternate">
                            <span>Nur Lags vorne</span>
                            <strong>@basket.LagOnlyBetterCount</strong>
                        </div>
                    </div>

                    <div class="benchmark-lists">
                        <div>
                            <span class="tag-label">Technisch erweitert besser</span>
                            <div class="tag-list">
                                @foreach (var ticker in basket.TechnicalExtendedBetterTickers)
                                {
                                    <span class="ticker-tag positive">@ticker</span>
                                }
                            </div>
                        </div>
                        <div>
                            <span class="tag-label">Nur Lags besser</span>
                            <div class="tag-list">
                                @foreach (var ticker in basket.LagOnlyBetterTickers)
                                {
                                    <span class="ticker-tag muted">@ticker</span>
                                }
                            </div>
                        </div>
                    </div>
                </article>
            }
        </section>
    </div>
}

@code {
    private static readonly CultureInfo UiCulture = CultureInfo.GetCultureInfo("de-DE");

    private DashboardDataSnapshot? _snapshot;
    private string? _selectedTickerSymbol;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _snapshot = await DashboardDataService.GetLatestAsync();
        _selectedTickerSymbol = _snapshot.Payload?.FeaturedTickers.FirstOrDefault()?.Ticker;
        _isLoading = false;
    }

    private void SelectTicker(string tickerSymbol)
    {
        _selectedTickerSymbol = tickerSymbol;
    }

    private FeaturedTicker GetActiveTicker(DashboardPayload payload)
    {
        return payload.FeaturedTickers.FirstOrDefault(ticker => ticker.Ticker == _selectedTickerSymbol)
            ?? payload.FeaturedTickers.First();
    }

    private static CompanyRankingEntry? GetActiveRankingEntry(DashboardPayload payload, string tickerSymbol)
    {
        return payload.CompanyRanking.FirstOrDefault(entry => entry.Ticker == tickerSymbol);
    }

    private static string FormatDate(DateOnly date) => date.ToString("dd. MMM yyyy", UiCulture);

    private static string FormatDateTime(DateTime dateTime) => dateTime.ToString("dd. MMM yyyy | HH:mm", UiCulture);

    private static string FormatPrice(double value) => value.ToString("N2", UiCulture);

    private static string FormatRmse(double value) => value.ToString("0.000", UiCulture);

    private static string FormatSignedRmse(double value) => $"{(value >= 0 ? "+" : string.Empty)}{value.ToString("0.000", UiCulture)}";

    private static string FormatPercent(double value) => $"{(value >= 0 ? "+" : string.Empty)}{value.ToString("0.00", UiCulture)}%";

    private static string FormatPlainPercent(double value) => $"{value.ToString("0.00", UiCulture)}%";

    private static string FormatScore(double value) => value.ToString("0.0", UiCulture);

    private static string FormatModelLabel(string rawValue, string fallback)
    {
        return rawValue switch
        {
            "random_forest" => "Random Forest",
            "ridge_regression" => "Ridge-Regression",
            "decision_tree" => "Entscheidungsbaum",
            _ when !string.IsNullOrWhiteSpace(rawValue) => rawValue.Replace("_", " "),
            _ => fallback,
        };
    }

    private static string FormatFeatureProfileLabel(string rawValue)
    {
        return rawValue switch
        {
            "technical_extended" => "Technisch erweitert",
            "technical_basic" => "Technisch grundlegend",
            "lag_only" => "Nur Lags",
            _ => rawValue.Replace("_", " "),
        };
    }

    private static string FormatBasketLabel(string basketKey, string fallback)
    {
        return basketKey switch
        {
            "core" => "Bachelor Kernkorb",
            "diversified" => "Bachelor diversifiziert",
            _ => fallback,
        };
    }

    private static string FormatMultiAssetBasketLabel(string basketKey, string fallback)
    {
        return basketKey switch
        {
            "starter" => "Starter-Korb",
            "bachelor_core" => "Bachelor Kernkorb",
            "bachelor_diversified" => "Bachelor diversifiziert",
            "etf_core" => "ETF-Kernkorb",
            "etf_sectors" => "ETF-Sektorkorb",
            "mixed_assets" => "Gemischter Aktien- und ETF-Korb",
            _ => fallback,
        };
    }

    private static string GetTrendTone(double value)
    {
        return value switch
        {
            > 0.01 => "tone-positive",
            < -0.01 => "tone-negative",
            _ => "tone-neutral",
        };
    }

    private static string MapToneToSparkline(double value)
    {
        return value switch
        {
            > 0.01 => "up",
            < -0.01 => "down",
            _ => "flat",
        };
    }

    private static string GetGapTone(double value)
    {
        return value switch
        {
            < 0 => "tone-positive",
            > 0 => "tone-negative",
            _ => "tone-neutral",
        };
    }

    private static IReadOnlyList<double> GetSparklineValues(FeaturedTicker ticker)
    {
        var values = new List<double> { ticker.LastClose };
        values.AddRange(ticker.ForecastPath.Select(point => point.PredictedClose));
        return values;
    }

    private static double GetShare(int value, int total)
    {
        return total == 0 ? 0 : (value / (double)total) * 100;
    }
}
