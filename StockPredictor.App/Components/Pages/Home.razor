    private void OpenAsset(string tickerSymbol)
    {
        NavigationManager.NavigateTo($"/assets/{Uri.EscapeDataString(AssetCatalogService.NormalizeTicker(tickerSymbol))}");
    }

    private Task OpenAssetFromCard(string tickerSymbol)
    {
        OpenAsset(tickerSymbol);
        return Task.CompletedTask;
    }

    private async Task ToggleWatchlistAsync(string tickerSymbol)
    {
        var normalizedTicker = AssetCatalogService.NormalizeTicker(tickerSymbol);

        if (IsInWatchlist(normalizedTicker))
        {
            _watchlistTickers = _watchlistTickers
                .Where(existingTicker => !string.Equals(existingTicker, normalizedTicker, StringComparison.OrdinalIgnoreCase))
                .ToList();
            try
            {
                await BrowserWatchlistService.RemoveAsync(normalizedTicker);
            }
            catch (InvalidOperationException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
        }
        else
        {
            var asset = _assetEntries.FirstOrDefault(entry =>
                string.Equals(entry.Ticker, normalizedTicker, StringComparison.OrdinalIgnoreCase))
                ?? AssetCatalogService.CreatePlaceholderEntry(normalizedTicker);
            _watchlistTickers.Add(normalizedTicker);
            try
            {
                await BrowserWatchlistService.AddOrUpdateAsync(asset);
            }
            catch (InvalidOperationException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
        }

        try
        {
            _profile = await ProfileService.GetProfileAsync(forceReload: true);
            _watchlistTickers = _profile.Watchlist.Select(item => item.Symbol).ToList();
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSDisconnectedException)
        {
        }

        await RefreshMarketOverviewAsync();
        _newsSnapshot = await NewsService.GetSnapshotAsync(new NewsQuery
        {
            MaxItems = 4,
            PreferredTickers = _watchlistTickers,
            PreferredCategories = _profile?.News.PreferredNewsCategories,
            PreferTickerMatches = true,
        });
        if (_snapshot?.Payload is not null)
        {
            _notificationCheckPending = true;
        }
    }

    private Task ToggleWatchlistFromCard(string tickerSymbol)
    {
        return ToggleWatchlistAsync(tickerSymbol);
    }

    private bool IsInWatchlist(string tickerSymbol)
    {
        return _watchlistTickers.Any(existingTicker =>
            string.Equals(existingTicker, tickerSymbol, StringComparison.OrdinalIgnoreCase));
    }

    private string GetWatchlistButtonLabel(string tickerSymbol)
