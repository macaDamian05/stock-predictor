@page "/"
@using System.Globalization
@using Microsoft.JSInterop
@implements IDisposable
@inject AssetCatalogService AssetCatalogService
@inject BrowserWatchlistService BrowserWatchlistService
@inject DashboardDataService DashboardDataService
@inject MarketDataService MarketDataService
@inject ForecastJobService ForecastJobService
@inject NewsService NewsService
@inject NotificationService NotificationService
@inject LocalUserProfileService ProfileService
@inject NavigationManager NavigationManager

<PageTitle>Stock-Predictor-Dashboard</PageTitle>

@if (_isLoading)
{
    <section class="dashboard-empty panel-shell">
        <span class="section-kicker">Laden</span>
        <h1>Dashboard wird aufgebaut...</h1>
        <p>Die App lädt lokale Kursdaten, Watchlist und den aktuellen Forschungsstand.</p>
    </section>
}
else
{
    var payload = _snapshot?.Payload;
    var searchResults = GetSearchResults();
    var watchlistEntries = GetWatchlistEntries();
    var homeMarketEntries = GetHomeMarketEntries();
    var activeJobs = ForecastJobService.GetJobs()
        .Where(job => job.State is ForecastJobState.Pending or ForecastJobState.Running or ForecastJobState.Failed)
        .Take(4)
        .ToArray();

    <div class="dashboard-page">
        @if (_snapshot?.Payload is null)
        {
            <section class="panel-shell status-banner">
                <div>
                    <span class="section-kicker">Research Layer fehlt</span>
                    <h2>Die App bleibt nutzbar, aber der lokale Dashboard-Payload fehlt.</h2>
                    <p>
                        Kursdaten können trotzdem geladen werden. Für Prognosen und Modellmetriken muss
                        <code>StockPredictor.ML/storage/dashboard/LATEST/dashboard_payload.json</code> lokal vorhanden sein.
                    </p>
                </div>
                <div class="command-list">
                    <code>cd StockPredictor.ML</code>
                    <code>.\.venv\Scripts\python.exe export_dashboard_payload.py</code>
                </div>
            </section>
        }

        <section class="market-hero panel-shell" id="market">
            <div class="hero-copy">
                <span class="section-kicker">Marktüberblick</span>
                <h1>Echte Kursdaten zuerst, Forecasts als separater Research Layer.</h1>
                <p>
                    Die App trennt frische Marktdaten, lokale ML-Prognosen und veraltete Exporte sichtbar voneinander.
                </p>

                <div class="hero-actions">
                    <a class="action-link action-primary" href="#asset-discovery">Assets suchen</a>
                    <a class="action-link" href="news">News-Kontext</a>
                    <a class="action-link" href="profile">Profil</a>
                    <a class="action-link" href="hinweise">FAQ & Methodik</a>
                </div>
            </div>

            <div class="hero-stats">
                <article class="hero-stat">
                    <span>Bekannte Assets</span>
                    <strong>@_assetEntries.Count</strong>
                    <small>Ticker- und Alias-Suche</small>
                </article>
                <article class="hero-stat">
                    <span>Watchlist</span>
                    <strong>@_watchlistTickers.Count</strong>
                    <small>Lokal im Browser gespeichert</small>
                </article>
                <article class="hero-stat">
                    <span>Market Data Layer</span>
                    <strong>@homeMarketEntries.Count</strong>
                    <small>Aktuelle Kurskarten</small>
                </article>
                <article class="hero-stat">
                    <span>Research Layer</span>
                    <strong>@(payload?.FeaturedTickers.Count ?? 0)</strong>
                    <small>@(payload is null ? "Kein Payload" : "Vorbereitete Forecasts")</small>
                </article>
                <article class="hero-stat">
                    <span>Datenstand Kurslayer</span>
                    <strong>@FormatTimestamp(GetNewestMarketTimestamp(homeMarketEntries))</strong>
                    <small>Frisch geladene Kursdaten</small>
                </article>
                <article class="hero-stat">
                    <span>Datenstand Forecastlayer</span>
                    <strong>@(payload is null ? "n/a" : FormatNullableDate(payload.DataUntil))</strong>
                    <small>@(payload is null ? "Noch kein Export" : GetPayloadFreshnessLabel(payload))</small>
                </article>
            </div>
        </section>

        <section class="discovery-grid" id="asset-discovery">
            <article class="panel-shell discovery-panel">
                <div class="panel-header">
                    <div>
                        <span class="section-kicker">Asset-Suche</span>
                        <h2>Ticker oder Namen suchen, nicht nur Payload-Assets</h2>
                    </div>
                    <span class="meta-pill">@_assetEntries.Count bekannte Assets</span>
                </div>

                <form class="search-form" @onsubmit="HandleAssetSearchSubmit" @onsubmit:preventDefault="true">
                    <label class="sr-only" for="asset-search-input">Ticker oder Asset suchen</label>
                    <input id="asset-search-input"
                           class="search-input"
                           type="search"
                           placeholder="z. B. AAPL, apple, TSLA, siemens energy, SPY"
                           @bind="_assetSearchQuery"
                           @bind:event="oninput" />
                    <button class="status-button" type="submit" disabled="@string.IsNullOrWhiteSpace(GetSearchTargetTicker())">
                        Asset öffnen
                    </button>
                </form>

                <div class="search-meta">
                    <span class="meta-pill">
                        @(string.IsNullOrWhiteSpace(_assetSearchQuery)
                            ? "Suche über bekannte Aktien, ETFs und lokale Payload-Ticker"
                            : $"Treffer für „{_assetSearchQuery.Trim()}“")
                    </span>
                    @if (!string.IsNullOrWhiteSpace(_assetSearchQuery))
                    {
                        <button class="text-button" type="button" @onclick="ClearAssetSearch">
                            Suche zurücksetzen
                        </button>
                    }
                </div>

                @if (searchResults.Count > 0)
                {
                    <div class="asset-result-list">
                        @foreach (var asset in searchResults)
                        {
                            <article class="asset-result-row">
                                <div class="asset-result-copy">
                                    <div class="asset-result-head">
                                        <div class="asset-title-block">
                                            <strong>@asset.Ticker</strong>
                                            @if (!string.IsNullOrWhiteSpace(asset.DisplayName))
                                            {
                                                <small>@asset.DisplayName</small>
                                            }
                                        </div>
                                        <div class="asset-result-badges">
                                            @if (!string.IsNullOrWhiteSpace(asset.AssetType))
                                            {
                                                <span class="meta-pill">@asset.AssetType</span>
                                            }
                                            <span class="tone-pill @GetForecastAvailabilityTone(asset)">
                                                @GetForecastAvailabilityLabel(asset)
                                            </span>
                                        </div>
                                    </div>

                                    <div class="asset-result-metrics">
                                        <span>Letzter Kurs <strong>@FormatNullablePrice(GetAssetLastPrice(asset))</strong></span>
                                        <span>Kursdaten <strong>@FormatTimestamp(GetAssetLastTimestamp(asset))</strong></span>
                                        @if (asset.ForecastHorizonChangePct is double horizonChange)
                                        {
                                            <span>5 Tage <strong class="@GetTrendTone(horizonChange)">@FormatPercent(horizonChange)</strong></span>
                                        }
                                    </div>
                                </div>

                                <div class="asset-result-actions">
                                    <button class="action-button action-primary" type="button" @onclick="() => OpenAsset(asset.Ticker)">
                                        Öffnen
                                    </button>
                                    <button class="action-button action-secondary" type="button" @onclick="() => ToggleWatchlistAsync(asset.Ticker)">
                                        @GetWatchlistButtonLabel(asset.Ticker)
                                    </button>
                                </div>
                            </article>
                        }
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_assetSearchQuery))
                {
                    <article class="search-empty">
                        <span class="section-kicker">Kein bekannter Treffer</span>
                        <h3>@AssetCatalogService.NormalizeTicker(_assetSearchQuery)</h3>
                        <p>Für dieses Asset liegen aktuell weder bekannte Aliasdaten noch vorbereitete Prognosedaten vor.</p>
                        <p>Du kannst trotzdem die Detailansicht öffnen und dort einen lokalen Forecast-Lauf vorbereiten.</p>
                        <button class="action-button action-secondary" type="button" @onclick="() => OpenAsset(AssetCatalogService.NormalizeTicker(_assetSearchQuery))">
                            Kursansicht trotzdem öffnen
                        </button>
                    </article>
                }
            </article>

            <article class="panel-shell discovery-panel">
                <div class="panel-header">
                    <div>
                        <span class="section-kicker">Meine Watchlist</span>
                        <h2>Favoriten lokal speichern und als Marktansicht laden</h2>
                    </div>
                    <span class="meta-pill">@_watchlistTickers.Count gespeicherte Ticker</span>
                </div>

                @if (!_watchlistLoaded)
                {
                    <p class="watchlist-empty-copy">Die lokale Watchlist wird geladen.</p>
                }
                else if (watchlistEntries.Count == 0)
                {
                    <div class="watchlist-empty">
                        <p class="watchlist-empty-copy">
                            Noch keine lokalen Favoriten gespeichert. Füge Ticker über die Suche oder die Detailansicht hinzu.
                        </p>
                    </div>
                }
                else
                {
                    <div class="watchlist-inline-list">
                        @foreach (var asset in watchlistEntries)
                        {
                            <article class="watchlist-inline-row">
                                <div class="asset-result-copy">
                                    <div class="asset-result-head">
                                        <div class="asset-title-block">
                                            <strong>@asset.Ticker</strong>
                                            @if (!string.IsNullOrWhiteSpace(asset.DisplayName))
                                            {
                                                <small>@asset.DisplayName</small>
                                            }
                                        </div>
                                        <div class="asset-result-badges">
                                            <span class="tone-pill @GetForecastAvailabilityTone(asset)">
                                                @GetForecastAvailabilityLabel(asset)
                                            </span>
                                        </div>
                                    </div>
                                    <div class="asset-result-metrics">
                                        <span>Letzter Kurs <strong>@FormatNullablePrice(GetAssetLastPrice(asset))</strong></span>
                                        <span>1M <strong class="@GetRangeTone(asset.Ticker, MarketTimeRange.OneMonth)">@FormatRangePercent(asset.Ticker, MarketTimeRange.OneMonth)</strong></span>
                                    </div>
                                </div>
                                <div class="asset-result-actions">
                                    <button class="action-button action-primary" type="button" @onclick="() => OpenAsset(asset.Ticker)">
                                        Details
                                    </button>
                                    <button class="action-button action-secondary" type="button" @onclick="() => ToggleWatchlistAsync(asset.Ticker)">
                                        Entfernen
                                    </button>
                                </div>
                            </article>
                        }
                    </div>
                }
            </article>
        </section>

        @if (activeJobs.Length > 0)
        {
            <section class="panel-shell">
                <div class="panel-header">
                    <div>
                        <span class="section-kicker">Lokale Aktualisierung</span>
                        <h2>Forecast-Daten werden im Hintergrund verarbeitet</h2>
                    </div>
                    <span class="meta-pill">Die App bleibt nutzbar</span>
                </div>
                <div class="jobs-grid">
                    @foreach (var job in activeJobs)
                    {
                        <ForecastJobPanel Job="job" />
                    }
                </div>
            </section>
        }

        <section class="market-board panel-shell" id="ticker-board">
            <div class="panel-header board-header">
                <div>
                    <span class="section-kicker">Market Data Layer</span>
                    <h2>Frische Kurskarten mit Verlauf und Zeitraumveränderungen</h2>
                </div>
                <span class="meta-pill">Forecast-Status bleibt sekundär</span>
            </div>

            <div class="market-card-grid">
                @foreach (var asset in homeMarketEntries)
                {
                    var marketSnapshot = GetMarketSnapshot(asset.Ticker);
                    var rangeChanges = GetRangeChanges(asset.Ticker);
                    var forecastJob = ForecastJobService.GetJob(asset.Ticker);

                    <MarketTickerCard Asset="asset"
                                      MarketSnapshot="marketSnapshot"
                                      RangeChanges="rangeChanges"
                                      ForecastJob="forecastJob"
                                      PrimaryRange="@GetPreferredDashboardRange()"
                                      IsInWatchlist="IsInWatchlist(asset.Ticker)"
                                      IsForecastStale="IsAssetForecastStale(asset)"
                                      OnOpen="OpenAssetFromCard"
                                      OnToggleWatchlist="ToggleWatchlistFromCard" />
                }
            </div>
        </section>

        @if (payload is not null)
        {
            <section class="summary-grid">
                <article class="panel-shell summary-card accent-starter">
                    <span class="section-kicker">Research Layer</span>
                    <h2>Starter-Export</h2>
                    <div class="card-value">@payload.SummaryCards.StarterBestExperiment.FeatureProfile</div>
                    <div class="card-metrics">
                        <span>Ticker <strong>@payload.SummaryCards.StarterBestExperiment.TickerCount</strong></span>
                        <span>Dominantes Modell <strong>@payload.SummaryCards.StarterBestExperiment.DominantBestModelLabel</strong></span>
                        <span>Baseline geschlagen <strong>@payload.SummaryCards.StarterTickersBeatingBaseline.Count</strong></span>
                    </div>
                </article>

                <article class="panel-shell summary-card accent-core">
                    <span class="section-kicker">Modelle</span>
                    <h2>Kernprofil</h2>
                    <div class="card-value">@payload.SummaryCards.BestCoreProfile.FeatureProfileLabel</div>
                    <div class="card-metrics">
                        <span>RMSE <strong>@FormatRmse(payload.SummaryCards.BestCoreProfile.MeanBestLearnedRmse)</strong></span>
                        <span>Richtung <strong>@FormatRatePercent(payload.SummaryCards.BestCoreProfile.MeanBestLearnedDirectionalAccuracy * 100)</strong></span>
                        <span>Modell <strong>@payload.SummaryCards.BestCoreProfile.DominantBestModelLabel</strong></span>
                    </div>
                </article>

                <article class="panel-shell summary-card accent-diversified">
                    <span class="section-kicker">Modelle</span>
                    <h2>Diversifiziertes Profil</h2>
                    <div class="card-value">@payload.SummaryCards.BestDiversifiedProfile.FeatureProfileLabel</div>
                    <div class="card-metrics">
                        <span>RMSE <strong>@FormatRmse(payload.SummaryCards.BestDiversifiedProfile.MeanBestLearnedRmse)</strong></span>
                        <span>Richtung <strong>@FormatRatePercent(payload.SummaryCards.BestDiversifiedProfile.MeanBestLearnedDirectionalAccuracy * 100)</strong></span>
                        <span>Modell <strong>@payload.SummaryCards.BestDiversifiedProfile.DominantBestModelLabel</strong></span>
                    </div>
                </article>

                <article class="panel-shell summary-card accent-neutral">
                    <span class="section-kicker">Payload-Status</span>
                    <h2>Lokaler Exportstand</h2>
                    <div class="card-value">@FormatDateTime(payload.GeneratedAt)</div>
                    <div class="card-metrics">
                        <span>Datenstand <strong>@FormatNullableDate(payload.DataUntil)</strong></span>
                        <span>Verfügbare Forecasts <strong>@payload.FeaturedTickers.Count</strong></span>
                        <span>Multi-Asset-Summaries <strong>@payload.MultiAssetSummaries.Count</strong></span>
                    </div>
                </article>
            </section>

            <section class="benchmark-grid">
                <article class="panel-shell benchmark-card">
                    <div class="panel-header">
                        <div>
                            <span class="section-kicker">Ranking</span>
                            <h2>Unternehmensranking aus lokalem Payload</h2>
                        </div>
                        <span class="meta-pill">Forecasts bleiben Forschung</span>
                    </div>
                    <div class="compact-ranking">
                        @foreach (var entry in payload.CompanyRanking.Take(5))
                        {
                            <button class="compact-ranking-row"
                                    type="button"
                                    @onclick="() => OpenAsset(entry.Ticker)">
                                <span class="compact-rank">#@entry.Rank</span>
                                <span>
                                    <strong>@entry.Ticker</strong>
                                    <small>@FormatModelLabel(entry.ForecastModel, entry.ForecastModelLabel) · @FormatFeatureProfileLabel(entry.FeatureProfile)</small>
                                </span>
                                <span class="@GetTrendTone(entry.ForecastHorizonChangePct)">
                                    @FormatPercent(entry.ForecastHorizonChangePct)
                                </span>
                            </button>
                        }
                    </div>
                </article>

                <article class="panel-shell benchmark-card">
                    <div class="panel-header">
                        <div>
                            <span class="section-kicker">Multi-Asset</span>
                            <h2>Gemeinsame Körbe und ETFs</h2>
                        </div>
                        <span class="meta-pill">@payload.MultiAssetSummaries.Count Läufe</span>
                    </div>
                    @if (payload.MultiAssetSummaries.Count > 0)
                    {
                        <div class="run-list">
                            @foreach (var summary in payload.MultiAssetSummaries.Take(4))
                            {
                                <div>
                                    <span>@summary.BasketLabel</span>
                                    <strong>@summary.SharedModelLabel · @summary.FeatureProfileLabel</strong>
                                    <small>@summary.TickerCount Assets · RMSE @FormatRmse(summary.SharedModelRmse)</small>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="card-copy">Noch keine Multi-Asset-Zusammenfassung im lokalen Payload verfügbar.</p>
                    }
                </article>
            </section>
        }

        <section class="teaser-grid">
            <article class="panel-shell teaser-card">
                <span class="section-kicker">Benachrichtigungen</span>
                <h2>Lokale Statusmeldungen testen</h2>
                <NotificationStatusCard />
            </article>

            <article class="panel-shell teaser-card">
                <span class="section-kicker">News-Kontext</span>
                <h2>Aktuelle News nur als Kontext</h2>
                <p class="card-copy">News dienen aktuell nur als Kontext und fließen noch nicht automatisch in die Prognose ein.</p>
                @if (_newsSnapshot?.Items.Count > 0)
                {
                    <div class="run-list">
                        @foreach (var item in _newsSnapshot.Items.Take(3))
                        {
                            <div>
                                <span>@item.Category · @item.Source</span>
                                <strong>@item.Title</strong>
                                <small>@FormatDateTime(item.PublishedAt)</small>
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_newsSnapshot.StatusNotice))
                    {
                        <p class="card-copy">@_newsSnapshot.StatusNotice</p>
                    }
                    <a class="action-link action-secondary" href="news">Alle News ansehen</a>
                }
                else
                {
                    <p class="card-copy">@(_newsSnapshot?.StatusNotice ?? "Zurzeit sind keine News verfügbar.")</p>
                }
            </article>

            <article class="panel-shell teaser-card">
                <span class="section-kicker">Methodik</span>
                <h2>Kurse und Forecasts werden bewusst getrennt</h2>
                <p>
                    Frische Kursdaten können für mehr Assets geladen werden. Forecasts bleiben lokale ML-Artefakte und
                    können veraltet sein. Alte Forecasts sind keine Live-Prognose.
                </p>
                <a class="action-link action-secondary" href="hinweise">FAQ & Methodik öffnen</a>
            </article>

            <article class="panel-shell teaser-card">
                <span class="section-kicker">Profil</span>
                <h2>Lokale Einstellungen für dieses Dashboard</h2>
                <p>
                    Watchlist, bevorzugte Assets, Chart-Zeitraum, Forecast-Anzeige, News-Kategorien und
                    Benachrichtigungen werden lokal im Browser gespeichert.
                </p>
                <div class="tag-list">
                    <span class="meta-pill planned-pill">@(_profile?.ProfileName ?? "Mein Profil")</span>
                    <span class="meta-pill planned-pill">Kein Login</span>
                    <span class="meta-pill planned-pill">Keine Cloud</span>
                </div>
                <a class="action-link action-secondary" href="profile">Profil öffnen</a>
            </article>
        </section>
    </div>
}

@code {
    private static readonly CultureInfo UiCulture = CultureInfo.GetCultureInfo("de-DE");
    private static readonly string[] DefaultHomeTickers = ["AAPL", "MSFT", "NVDA", "TSLA", "SPY", "ENR.DE"];

    private DashboardDataSnapshot? _snapshot;
    private NewsFeedSnapshot? _newsSnapshot;
    private LocalUserProfile? _profile;
    private IReadOnlyList<AssetCatalogEntry> _assetEntries = [];
    private readonly Dictionary<string, MarketAssetSnapshot> _marketSnapshots = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, IReadOnlyDictionary<MarketTimeRange, MarketRangeChange>> _marketChanges = new(StringComparer.OrdinalIgnoreCase);
    private List<string> _watchlistTickers = [];
    private string _assetSearchQuery = string.Empty;
    private bool _notificationCheckPending;
    private bool _isLoading = true;
    private bool _watchlistLoaded;
    private bool _reloadingAfterJob;

    protected override async Task OnInitializedAsync()
    {
        ForecastJobService.JobsChanged += HandleJobsChanged;
        await LoadHomeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_watchlistLoaded)
        {
            await LoadWatchlistAsync();
        }

        if (_notificationCheckPending && _snapshot?.Payload is not null)
        {
            _notificationCheckPending = false;
            await NotificationService.CheckForPayloadUpdatesAsync(_snapshot.Payload, _watchlistTickers);
        }
    }

    private async Task LoadHomeAsync()
    {
        _snapshot = await DashboardDataService.GetLatestAsync();
        _newsSnapshot = await NewsService.GetSnapshotAsync(new NewsQuery
        {
            MaxItems = 4,
            PreferredTickers = _watchlistTickers,
            PreferredCategories = _profile?.News.PreferredNewsCategories,
            PreferTickerMatches = true,
        });
        _assetEntries = AssetCatalogService.BuildEntries(_snapshot.Payload);
        await RefreshMarketOverviewAsync();

        if (_snapshot.Payload is not null)
        {
            await ForecastJobService.QueueAutomaticRefreshesAsync(_snapshot.Payload, GetAutoRefreshTickers());
            _notificationCheckPending = true;
        }

        _isLoading = false;
    }

    private async Task RefreshMarketOverviewAsync()
    {
        var tickers = GetHomeMarketTickers();
        var snapshots = await MarketDataService.GetSnapshotsAsync(tickers);

        _marketSnapshots.Clear();
        _marketChanges.Clear();

        foreach (var (ticker, snapshot) in snapshots)
        {
            _marketSnapshots[ticker] = snapshot;
            _marketChanges[ticker] = MarketDataService.GetRangeChanges(snapshot);
        }
    }

    private async Task LoadWatchlistAsync()
    {
        try
        {
            _profile = await ProfileService.GetProfileAsync(forceReload: true);
            _watchlistTickers = _profile.Watchlist
                .Select(item => item.Symbol)
                .ToList();
        }
        catch (InvalidOperationException)
        {
            _watchlistTickers = [];
        }
        catch (JSDisconnectedException)
        {
            _watchlistTickers = [];
        }
        finally
        {
            _watchlistLoaded = true;
        }

        await RefreshMarketOverviewAsync();
        _newsSnapshot = await NewsService.GetSnapshotAsync(new NewsQuery
        {
            MaxItems = 4,
            PreferredTickers = _watchlistTickers,
            PreferredCategories = _profile?.News.PreferredNewsCategories,
            PreferTickerMatches = true,
        });

        if (_snapshot?.Payload is not null)
        {
            await ForecastJobService.QueueAutomaticRefreshesAsync(_snapshot.Payload, GetAutoRefreshTickers());
            _notificationCheckPending = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<string> GetHomeMarketTickers()
    {
        var tickers = new List<string>();
        if (_profile?.Dashboard.PreferredDashboardAssets.Count > 0)
        {
            tickers.AddRange(_profile.Dashboard.PreferredDashboardAssets);
        }

        tickers.AddRange(_watchlistTickers);
        if (_snapshot?.Payload is not null)
        {
            tickers.AddRange(_snapshot.Payload.FeaturedTickers.Select(ticker => ticker.Ticker));
        }

        tickers.AddRange(DefaultHomeTickers);

        return tickers
            .Select(AssetCatalogService.NormalizeTicker)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(9)
            .ToArray();
    }

    private IReadOnlyList<string> GetAutoRefreshTickers()
    {
        return (_snapshot?.Payload?.FeaturedTickers.Select(ticker => ticker.Ticker) ?? [])
            .Concat(_watchlistTickers)
            .Select(AssetCatalogService.NormalizeTicker)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private IReadOnlyList<AssetCatalogEntry> GetHomeMarketEntries()
    {
        return GetHomeMarketTickers()
            .Select(ticker => _assetEntries.FirstOrDefault(entry =>
                string.Equals(entry.Ticker, ticker, StringComparison.OrdinalIgnoreCase))
                ?? AssetCatalogService.CreatePlaceholderEntry(ticker))
            .ToArray();
    }

    private IReadOnlyList<AssetCatalogEntry> GetSearchResults()
    {
        return AssetCatalogService.Search(_assetEntries, _assetSearchQuery);
    }

    private IReadOnlyList<AssetCatalogEntry> GetWatchlistEntries()
    {
        return _watchlistTickers
            .Select(ticker => _assetEntries.FirstOrDefault(entry =>
                string.Equals(entry.Ticker, ticker, StringComparison.OrdinalIgnoreCase))
                ?? AssetCatalogService.CreatePlaceholderEntry(ticker))
            .ToArray();
    }

    private string? GetSearchTargetTicker()
    {
        if (string.IsNullOrWhiteSpace(_assetSearchQuery))
        {
            return null;
        }

        return AssetCatalogService.ResolveTicker(_assetSearchQuery, _assetEntries);
    }

    private async Task HandleAssetSearchSubmit()
    {
        var targetTicker = GetSearchTargetTicker();
        if (!string.IsNullOrWhiteSpace(targetTicker))
        {
            OpenAsset(targetTicker);
        }

        await Task.CompletedTask;
    }

