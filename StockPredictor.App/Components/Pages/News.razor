@page "/news"
@inject NewsService NewsService

<PageTitle>News-Kontext</PageTitle>

@if (_isLoading)
{
    <section class="news-shell news-empty">
        <span class="section-kicker">Laden</span>
        <h1>News werden geladen...</h1>
        <p>Die App lädt konfigurierbare externe Quellen oder einen klar markierten Demo-Modus.</p>
    </section>
}
else if (_snapshot is null)
{
    <section class="news-shell news-empty">
        <span class="section-kicker">News</span>
        <h1>Der News-Bereich konnte nicht geladen werden.</h1>
        <p>Die App bleibt nutzbar. News sind aktuell nur ergänzender Kontext und unabhängig vom ML-Training.</p>
    </section>
}
else
{
    var snapshot = _snapshot;

    <div class="news-page">
        <section class="news-shell news-hero">
            <div class="news-hero-copy">
                <span class="section-kicker">News-Kontext</span>
                <h1>Echte Quellen, klarer Status, kein Trading-Signal</h1>
                <p>@snapshot.ModelUsageNotice</p>
            </div>

            <div class="news-hero-meta">
                <span class="meta-pill">Quelle: @snapshot.ProviderLabel</span>
                <span class="meta-pill @(snapshot.IsDemoData ? "demo-pill" : string.Empty)">
                    @GetLoadStatusLabel(snapshot.LoadStatus)
                </span>
            </div>
        </section>

        <section class="news-shell news-callout">
            <p>@snapshot.ContextNotice</p>
            <p>@snapshot.StatusNotice</p>
            <p>Keine Anlageberatung. News werden aktuell nicht automatisch in die Modellprognosen übernommen.</p>

            @if (snapshot.SourceWarnings.Count > 0)
            {
                <div class="news-warning-list">
                    @foreach (var warning in snapshot.SourceWarnings)
                    {
                        <span class="warning-pill">@warning</span>
                    }
                </div>
            }
        </section>

        <section class="news-shell">
            <div class="panel-header">
                <div>
                    <span class="section-kicker">Filter</span>
                    <h2>News nach Kategorie und Ticker eingrenzen</h2>
                </div>
                <button class="filter-reset" type="button" @onclick="ResetFiltersAsync">
                    Filter zurücksetzen
                </button>
            </div>

            <div class="filter-grid">
                <label class="filter-field">
                    <span>Kategorie</span>
                    <select value="@_selectedCategory" @onchange="HandleCategoryChangedAsync">
                        @foreach (var category in snapshot.AvailableCategories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </label>

                <label class="filter-field">
                    <span>Ticker</span>
                    <select value="@_selectedTicker" @onchange="HandleTickerChangedAsync">
                        @foreach (var ticker in snapshot.AvailableTickers)
                        {
                            <option value="@ticker">@ticker</option>
                        }
                    </select>
                </label>
            </div>
        </section>

        <section class="news-list-section">
            <div class="panel-header">
                <div>
                    <span class="section-kicker">News-Liste</span>
                    <h2>@snapshot.Items.Count Einträge im aktuellen Filter</h2>
                </div>
            </div>

            @if (snapshot.Items.Count == 0)
            {
                <section class="news-shell news-empty">
                    <h3>@GetEmptyHeadline(snapshot.LoadStatus)</h3>
                    <p>@GetEmptyMessage(snapshot)</p>
                </section>
            }
            else
            {
                <div class="news-grid">
                    @foreach (var item in snapshot.Items)
                    {
                        <article class="news-shell news-card">
                            <div class="news-card-head">
                                <span class="category-pill">@item.Category</span>
                                <div class="news-card-badges">
                                    @if (item.IsDemo)
                                    {
                                        <span class="meta-pill demo-pill">Demo</span>
                                    }
                                    @if (item.IsExternal)
                                    {
                                        <span class="meta-pill">Extern</span>
                                    }
                                </div>
                            </div>

                            <h3>@item.Title</h3>
                            <p class="news-meta">@FormatPublishedAt(item.PublishedAt) · @item.Source</p>

                            @if (!string.IsNullOrWhiteSpace(item.Summary))
                            {
                                <p class="news-summary">@item.Summary</p>
                            }

                            @if (item.AffectedTickers.Count > 0)
                            {
                                <div class="ticker-tag-list">
                                    @foreach (var ticker in item.AffectedTickers)
                                    {
                                        <span class="ticker-tag">@ticker</span>
                                    }
                                </div>
                            }

                            <div class="news-actions">
                                @if (!string.IsNullOrWhiteSpace(item.Url))
                                {
                                    <a class="action-link action-secondary"
                                       href="@item.Url"
                                       target="_blank"
                                       rel="noreferrer noopener">
                                        Artikel öffnen
                                    </a>
                                }
                                else
                                {
                                    <span class="meta-pill demo-pill">Kein Originalartikel im Demo-Modus</span>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    private NewsFeedSnapshot? _snapshot;
    private string _selectedCategory = NewsService.AllCategories;
    private string _selectedTicker = NewsService.AllTickers;
    private bool _isLoading = true;

    [SupplyParameterFromQuery]
    public string? Category { get; set; }

    [SupplyParameterFromQuery]
    public string? Ticker { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _selectedCategory = string.IsNullOrWhiteSpace(Category) ? NewsService.AllCategories : Category.Trim();
        _selectedTicker = string.IsNullOrWhiteSpace(Ticker) ? NewsService.AllTickers : Ticker.Trim();
        await LoadSnapshotAsync();
    }

    private async Task LoadSnapshotAsync()
    {
        _isLoading = true;
        _snapshot = await NewsService.GetSnapshotAsync(new NewsQuery
        {
            Category = _selectedCategory,
            Ticker = _selectedTicker
        });
        _selectedCategory = _snapshot.SelectedCategory;
        _selectedTicker = _snapshot.SelectedTicker;
        _isLoading = false;
    }

    private async Task HandleCategoryChangedAsync(ChangeEventArgs args)
    {
        _selectedCategory = args.Value?.ToString() ?? NewsService.AllCategories;
        await LoadSnapshotAsync();
    }

    private async Task HandleTickerChangedAsync(ChangeEventArgs args)
    {
        _selectedTicker = args.Value?.ToString() ?? NewsService.AllTickers;
        await LoadSnapshotAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _selectedCategory = NewsService.AllCategories;
        _selectedTicker = NewsService.AllTickers;
        await LoadSnapshotAsync();
    }

    private static string GetLoadStatusLabel(NewsLoadStatus loadStatus)
    {
        return loadStatus switch
        {
            NewsLoadStatus.Loaded => "Externe Artikel geladen",
            NewsLoadStatus.Demo => "Demo-Modus aktiv",
            NewsLoadStatus.SourceUnavailable => "Quelle nicht erreichbar",
            _ => "Keine News verfügbar",
        };
    }

    private static string GetEmptyHeadline(NewsLoadStatus loadStatus)
    {
        return loadStatus switch
        {
            NewsLoadStatus.SourceUnavailable => "Externe Quellen derzeit nicht erreichbar",
            NewsLoadStatus.Demo => "Keine Demo-News für diesen Filter",
            _ => "Keine News für diese Filterkombination",
        };
    }

    private static string GetEmptyMessage(NewsFeedSnapshot snapshot)
    {
        return snapshot.LoadStatus switch
        {
            NewsLoadStatus.SourceUnavailable => "Bitte später erneut laden. Die App bleibt voll nutzbar und zeigt keine erfundenen Ersatzartikel.",
            NewsLoadStatus.Demo => "Bitte eine andere Kategorie oder einen anderen Ticker auswählen.",
            _ => snapshot.StatusNotice,
        };
    }

    private static string FormatPublishedAt(DateTime value)
    {
        return value.ToString("dd. MMM yyyy | HH:mm", System.Globalization.CultureInfo.GetCultureInfo("de-DE"));
    }
}
