@page "/Error"
@using System.Diagnostics

<PageTitle>Fehler</PageTitle>

<h1 class="text-danger">Fehler.</h1>
<h2 class="text-danger">Beim Verarbeiten der Anfrage ist ein Fehler aufgetreten.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>Anfrage-ID:</strong> <code>@RequestId</code>
    </p>
}

<h3>Entwicklungsmodus</h3>
<p>
    In der Umgebung <strong>Development</strong> werden detailliertere Informationen zu diesem Fehler angezeigt.
</p>
<p>
    <strong>Die Development-Umgebung sollte in produktiven Anwendungen nicht aktiviert sein.</strong>
    Andernfalls können sensible Ausnahmeinformationen sichtbar werden.
    Für lokales Debugging setze die Umgebungsvariable <strong>ASPNETCORE_ENVIRONMENT</strong> auf <strong>Development</strong>
    und starte die App neu.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [PersistentState]
    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId ??= Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
