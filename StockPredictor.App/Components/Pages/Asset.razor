@page "/assets/{TickerSymbol}"
@using System.Globalization
@inject AssetCatalogService AssetCatalogService
@inject DashboardDataService DashboardDataService
@inject MarketDataService MarketDataService

<PageTitle>Asset-Details</PageTitle>

@if (_isLoading)
{
    <section class="dashboard-empty panel-shell">
        <span class="section-kicker">Asset wird geladen</span>
        <h1>Kursdaten und gespeicherte Forecast-Daten werden gelesen.</h1>
        <p>Die Detailseite startet kein Training.</p>
    </section>
}
else if (_assetEntry is null)
{
    <section class="dashboard-empty panel-shell">
        <span class="section-kicker">Asset nicht verfügbar</span>
        <h1>Die Detailansicht konnte nicht aufgebaut werden.</h1>
        <a class="action-link action-primary" href="/">Zur Startseite</a>
    </section>
}
else
{
    var payload = _snapshot?.Payload;
    var asset = _assetEntry;
    var featuredTicker = asset.FeaturedTicker;
    var chartPoints = GetChartPoints();

    <div class="asset-page">
        <section class="asset-hero panel-shell">
            <div class="hero-copy">
                <span class="section-kicker">Asset-Details</span>
                <h1>@asset.Ticker</h1>
                @if (!string.IsNullOrWhiteSpace(asset.DisplayName) || !string.IsNullOrWhiteSpace(asset.AssetType))
                {
                    <p class="asset-subtitle">
                        @asset.DisplayName
                        @if (!string.IsNullOrWhiteSpace(asset.DisplayName) && !string.IsNullOrWhiteSpace(asset.AssetType))
                        {
                            <span>·</span>
                        }
                        @asset.AssetType
                    </p>
                }
                <p>
                    Kurschart und Forecast bleiben getrennt. Forecasts sind gespeicherte Modellprognosen
                    aus lokalen Artefakten und keine Anlageberatung.
                </p>
            </div>

            <div class="hero-meta">
                <div class="meta-group">
                    <span class="meta-pill">@GetForecastAvailabilityLabel(asset)</span>
                    @if (_marketSnapshot?.HasData == true)
                    {
                        <span class="meta-pill">Kursdaten bis @FormatTimestamp(_marketSnapshot.LastPoint?.Timestamp)</span>
                    }
                    @if (featuredTicker is not null && payload is not null)
                    {
                        <span class="meta-pill">@GetFreshnessLabel(payload, featuredTicker)</span>
                    }
                </div>
                <div class="hero-actions">
                    <a class="action-link action-secondary" href="/">Zur Startseite</a>
                </div>
            </div>
        </section>

        @if (payload is null)
        {
            <section class="panel-shell status-banner">
                <div>
                    <span class="section-kicker">Core-Payload fehlt</span>
                    <h2>Für dieses Asset können aktuell nur Kursdaten angezeigt werden.</h2>
                    <p>Trainiere das Core-Modell offline und exportiere danach den Dashboard-Payload.</p>
                </div>
                <div class="command-list">
                    @foreach (var command in GetCoreCommands(asset.Ticker))
                    {
                        <code>@command</code>
                    }
                </div>
            </section>
        }

        <section class="asset-main-shell panel-shell">
            <div class="panel-header">
                <div>
                    <span class="section-kicker">Kurschart</span>
                    <h2>Historischer Kursverlauf</h2>
                </div>

                <div class="range-toggle" role="tablist" aria-label="Zeitraum wählen">
                    @foreach (var range in Enum.GetValues<MarketTimeRange>())
                    {
                        <button class="@GetRangeTabClass(range)"
                                type="button"
                                @onclick="() => SelectRange(range)">
                            @GetRangeLabel(range)
                        </button>
                    }
                </div>
            </div>

            @if (_marketSnapshot?.HasData == true)
            {
                <div class="market-summary-grid">
                    <article class="mini-stat">
                        <span>Letzter Kurs</span>
                        <strong>@FormatPrice(_marketSnapshot.LastPoint?.Close)</strong>
                        <small>Kursdaten geladen bis: @FormatTimestamp(_marketSnapshot.LastPoint?.Timestamp)</small>
                    </article>
                    @foreach (var range in SummaryRanges)
                    {
                        if (_rangeChanges.TryGetValue(range, out var change))
                        {
                            <article class="mini-stat">
                                <span>Veränderung @GetRangeLabel(range)</span>
                                <strong class="@GetTrendTone(change.PercentChange)">@FormatPercent(change.PercentChange)</strong>
                                <small>@FormatAbsoluteChange(change.AbsoluteChange)</small>
                            </article>
                        }
                    }
                </div>

                <div class="chart-meta">
                    <span class="meta-pill">Kursdaten geladen bis: @FormatTimestamp(_marketSnapshot.LastPoint?.Timestamp)</span>
                    @if (featuredTicker is not null && payload is not null)
                    {
                        <span class="meta-pill">Forecast erzeugt am @FormatNullableDateTime(featuredTicker.ForecastGeneratedAt ?? payload.GeneratedAt)</span>
                    }
                    else
                    {
                        <span class="meta-pill">Noch kein gespeicherter Forecast vorhanden</span>
                    }
                </div>

                <PriceHistoryChart HistoryPoints="chartPoints"
                                   ForecastPoints="GetForecastPoints(featuredTicker)"
                                   ShowForecast="@(_showForecast && featuredTicker is not null)"
                                   AriaLabel="@($"{asset.Ticker} historischer Kurschart")" />

                @if (featuredTicker is not null)
                {
                    <div class="forecast-actions">
                        <button class="action-button action-secondary" type="button" @onclick="ToggleForecastOverlay">
                            @(_showForecast ? "Forecast ausblenden" : "Forecast einblenden")
                        </button>
                        <span class="forecast-action-note">Overlay aus gespeicherter Prediction, kein Live-Training.</span>
                    </div>
                }
            }
            else
            {
                <div class="dashboard-empty market-empty-state">
                    <span class="section-kicker">Kursdaten fehlen</span>
                    <h2>Marktdaten konnten lokal nicht geladen werden.</h2>
                    <p>@(_marketSnapshot?.Error ?? "Prüfe yfinance, Netzwerkzugriff und die lokale Python-Umgebung.")</p>
                    <div class="command-list">
                        <code>cd StockPredictor.ML</code>
                        <code>.\.venv\Scripts\python.exe export_market_data.py @asset.Ticker</code>
                    </div>
                </div>
            }
        </section>

        <section class="asset-research-shell panel-shell">
            <div class="panel-header">
                <div>
                    <span class="section-kicker">Core Forecast</span>
                    <h2>Prediction aus gespeicherten Modellen</h2>
                </div>
                <span class="meta-pill">Keine Anlageberatung</span>
            </div>

            @if (featuredTicker is not null && payload is not null)
            {
                <div class="forecast-meta-grid">
                    <article class="meta-card">
                        <span>Verwendetes Modell</span>
                        <strong>@GetSelectedModelLabel(featuredTicker)</strong>
                        <small>Auswahl über chronologische Validierungsmetriken</small>
                    </article>
                    <article class="meta-card">
                        <span>Modell trainiert am</span>
                        <strong>@FormatNullableDateTime(featuredTicker.ModelTrainedAt)</strong>
                        <small>Datenstand bis @FormatNullableDate(featuredTicker.DataUntil ?? payload.DataUntil)</small>
                    </article>
                    <article class="meta-card">
                        <span>Forecast erzeugt am</span>
                        <strong>@FormatNullableDateTime(featuredTicker.ForecastGeneratedAt ?? payload.GeneratedAt)</strong>
                        <small>Prediction ohne erneutes Training</small>
                    </article>
                    <article class="meta-card">
                        <span>Prognosehorizont</span>
                        <strong>@GetForecastHorizonDays(featuredTicker) Handelstage</strong>
                        <small>@FormatDate(featuredTicker.NextForecastDate) bis @FormatDate(featuredTicker.ForecastEndDate)</small>
                    </article>
                </div>

                @if (IsTickerStale(payload, featuredTicker))
                {
                    <div class="stale-banner">
                        Dieser Forecast ist veraltet. Starte lokal ein manuelles Retraining und exportiere danach den Payload neu.
                    </div>
                }

                <div class="research-banner">
                    Modellprognose als forschungsbasierte Schätzung. Keine Anlageberatung und kein Handelssignal.
                </div>

                <div class="detail-stats-grid">
                    <article class="mini-stat">
                        <span>Letzter Schlusskurs</span>
                        <strong>@FormatPrice(featuredTicker.LastClose)</strong>
                        <small>@FormatDate(featuredTicker.LastCloseDate)</small>
                    </article>
                    <article class="mini-stat">
                        <span>Nächste Modellprognose</span>
                        <strong>@FormatPrice(featuredTicker.NextPredictedClose)</strong>
                        <small class="@GetTrendTone(featuredTicker.NextPredictedChangePct)">@FormatPercent(featuredTicker.NextPredictedChangePct)</small>
                    </article>
                    <article class="mini-stat">
                        <span>Horizont-Veränderung</span>
                        <strong class="@GetTrendTone(featuredTicker.ForecastHorizonChangePct)">@FormatPercent(featuredTicker.ForecastHorizonChangePct)</strong>
                        <small>@GetForecastHorizonDays(featuredTicker) Handelstage</small>
                    </article>
                    <article class="mini-stat">
                        <span>Validierungs-RMSE</span>
                        <strong>@FormatRmse(featuredTicker.WalkForwardBestRmse)</strong>
                        <small>Baseline @FormatRmse(featuredTicker.WalkForwardBaselineRmse)</small>
                    </article>
                    <article class="mini-stat">
                        <span>Richtungstreffer</span>
                        <strong>@FormatRatePercent(featuredTicker.WalkForwardBestDirectionalAccuracy)</strong>
                        <small>Chronologische Validierung</small>
                    </article>
                    <article class="mini-stat">
                        <span>Validierungsfenster</span>
                        <strong>@FormatNullableDate(featuredTicker.ValidationStart)</strong>
                        <small>bis @FormatNullableDate(featuredTicker.ValidationEnd)</small>
                    </article>
                </div>

                <div class="forecast-strip">
                    @foreach (var point in featuredTicker.ForecastPath)
                    {
                        <article class="forecast-day">
                            <span>@FormatDate(point.Date)</span>
                            <strong>@FormatPrice(point.PredictedClose)</strong>
                            <small class="@GetTrendTone(point.PredictedReturn * 100)">
                                @FormatPercent(point.PredictedReturn * 100)
                            </small>
                        </article>
                    }
                </div>

                @if (featuredTicker.ModelMetrics.Count > 0)
                {
                    <div class="model-compare-grid">
                        @foreach (var modelMetric in featuredTicker.ModelMetrics)
                        {
                            <article class="model-compare-card @(modelMetric.IsSelected ? "is-selected" : string.Empty)">
                                <div class="model-card-header">
                                    <div>
                                        <span class="section-kicker">Untermodell</span>
                                        <h3>@modelMetric.ModelLabel</h3>
                                    </div>
                                    <span class="tone-pill @(modelMetric.IsSelected ? "tone-positive" : "tone-neutral")">
                                        @(modelMetric.IsSelected ? "Ausgewählt" : "Vergleich")
                                    </span>
                                </div>
                                <div class="model-metric-list">
                                    <span>RMSE <strong>@FormatNullableRmse(modelMetric.WalkForwardRmse)</strong></span>
                                    <span>MAE <strong>@FormatNullableRmse(modelMetric.WalkForwardMae)</strong></span>
                                    <span>Richtung <strong>@FormatNullableRatePercent(modelMetric.WalkForwardDirectionalAccuracy)</strong></span>
                                    <span>Gap vs. Baseline <strong>@FormatNullableSignedRmse(modelMetric.WalkForwardRmseGapVsBaseline)</strong></span>
                                </div>
                            </article>
                        }
                    </div>
                }
            }
            else
            {
                <div class="dashboard-empty market-empty-state">
                    <span class="section-kicker">Kein Forecast</span>
                    <h2>Für dieses Asset ist noch kein Core-Modell registriert.</h2>
                    <p>Trainiere das Modell offline. Danach erzeugst du eine Prediction und exportierst den Dashboard-Payload.</p>
                    <div class="command-list">
                        @foreach (var command in GetCoreCommands(asset.Ticker))
                        {
                            <code>@command</code>
                        }
                    </div>
                </div>
            }
        </section>
    </div>
}

@code {
    private static readonly CultureInfo UiCulture = CultureInfo.GetCultureInfo("de-DE");
    private static readonly MarketTimeRange[] SummaryRanges =
    [
        MarketTimeRange.OneDay,
        MarketTimeRange.OneWeek,
        MarketTimeRange.OneMonth,
        MarketTimeRange.SixMonths,
        MarketTimeRange.OneYear,
        MarketTimeRange.Max,
    ];

    [Parameter]
    public string TickerSymbol { get; set; } = string.Empty;

    private DashboardDataSnapshot? _snapshot;
    private AssetCatalogEntry? _assetEntry;
    private MarketAssetSnapshot? _marketSnapshot;
    private IReadOnlyDictionary<MarketTimeRange, MarketRangeChange> _rangeChanges =
        new Dictionary<MarketTimeRange, MarketRangeChange>();
    private MarketTimeRange _selectedRange = MarketTimeRange.OneMonth;
    private bool _showForecast = true;
    private bool _isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _snapshot = await DashboardDataService.GetLatestAsync();
        var assetEntries = AssetCatalogService.BuildEntries(_snapshot.Payload);
        _assetEntry = assetEntries.FirstOrDefault(entry =>
                         string.Equals(entry.Ticker, AssetCatalogService.NormalizeTicker(TickerSymbol), StringComparison.OrdinalIgnoreCase))
                     ?? AssetCatalogService.CreatePlaceholderEntry(TickerSymbol);

        _marketSnapshot = await MarketDataService.GetSnapshotAsync(_assetEntry.Ticker);
        _rangeChanges = MarketDataService.GetRangeChanges(_marketSnapshot);
        _isLoading = false;
    }

    private void SelectRange(MarketTimeRange range)
    {
        _selectedRange = range;
    }

    private void ToggleForecastOverlay()
    {
        _showForecast = !_showForecast;
    }

    private IReadOnlyList<MarketPricePoint> GetChartPoints()
    {
        return _marketSnapshot is null
            ? []
            : MarketDataService.GetRangePoints(_marketSnapshot, _selectedRange);
    }

    private static IReadOnlyList<ForecastPoint> GetForecastPoints(FeaturedTicker? featuredTicker)
    {
        return featuredTicker?.ForecastPath ?? [];
    }

    private static IReadOnlyList<string> GetCoreCommands(string ticker)
    {
        return
        [
            "cd StockPredictor.ML",
            $@".\.venv\Scripts\python.exe scripts\train_model_suite.py --symbols {ticker} --horizon 5",
            $@".\.venv\Scripts\python.exe scripts\predict_asset.py --symbol {ticker} --horizon 5",
            @".\.venv\Scripts\python.exe scripts\export_dashboard_payload.py",
        ];
    }

    private string GetRangeTabClass(MarketTimeRange range)
    {
        return range == _selectedRange ? "surface-tab is-active" : "surface-tab";
    }

    private static string GetForecastAvailabilityLabel(AssetCatalogEntry asset)
    {
        if (asset.ForecastAvailable)
        {
            return "Forecast verfügbar";
        }

        return asset.HasPreparedPayloadData ? "Payload vorhanden" : "Noch kein Forecast";
    }

    private static string GetRangeLabel(MarketTimeRange range)
    {
        return range switch
        {
            MarketTimeRange.OneDay => "1T",
            MarketTimeRange.OneWeek => "1W",
            MarketTimeRange.OneMonth => "1M",
            MarketTimeRange.SixMonths => "6M",
            MarketTimeRange.OneYear => "1J",
            MarketTimeRange.Max => "MAX",
            _ => "n/a",
        };
    }

    private static DateOnly? GetDataUntil(DashboardPayload payload, FeaturedTicker ticker)
    {
        return ticker.DataUntil ?? payload.DataUntil ?? ticker.LastCloseDate;
    }

    private static int GetForecastHorizonDays(FeaturedTicker ticker)
    {
        return ticker.ForecastHorizonDays > 0 ? ticker.ForecastHorizonDays : ticker.ForecastDays;
    }

    private static string GetSelectedModelLabel(FeaturedTicker ticker)
    {
        if (!string.IsNullOrWhiteSpace(ticker.SelectedModel.ModelLabel))
        {
            return ticker.SelectedModel.ModelLabel;
        }

        return FormatModelLabel(ticker.ForecastModel, ticker.ForecastModelLabel);
    }

    private static bool IsTickerStale(DashboardPayload payload, FeaturedTicker ticker)
    {
        var staleAfterDays = payload.StaleAfterDays > 0 ? payload.StaleAfterDays : 5;
        var today = DateOnly.FromDateTime(DateTime.Now);
        var dataUntil = GetDataUntil(payload, ticker) ?? ticker.LastCloseDate;
        var dataAgeDays = today.DayNumber - dataUntil.DayNumber;
        var forecastGeneratedAt = ticker.ForecastGeneratedAt ?? payload.GeneratedAt;
        var forecastAgeDays = Math.Max(0, (DateTime.Now.Date - forecastGeneratedAt.Date).Days);
        return dataAgeDays > staleAfterDays || forecastAgeDays > staleAfterDays;
    }

    private static string GetFreshnessLabel(DashboardPayload payload, FeaturedTicker ticker)
    {
        return IsTickerStale(payload, ticker) ? "Forecast veraltet" : "Forecast aktuell";
    }

    private static string FormatDate(DateOnly date) => date.ToString("dd. MMM yyyy", UiCulture);

    private static string FormatNullableDate(DateOnly? date) => date is null ? "nicht vorhanden" : FormatDate(date.Value);

    private static string FormatDateTime(DateTime dateTime) => dateTime.ToString("dd. MMM yyyy | HH:mm", UiCulture);

    private static string FormatNullableDateTime(DateTime? value) => value is null ? "nicht vorhanden" : FormatDateTime(value.Value);

    private static string FormatTimestamp(DateTime? value) => value is null ? "nicht vorhanden" : value.Value.ToString("dd. MMM yyyy | HH:mm", UiCulture);

    private static string FormatPrice(double? value) => value is null ? "nicht vorhanden" : value.Value.ToString("N2", UiCulture);

    private static string FormatRmse(double value) => value.ToString("0.000", UiCulture);

    private static string FormatNullableRmse(double? value) => value is null ? "nicht vorhanden" : FormatRmse(value.Value);

    private static string FormatSignedRmse(double value) => $"{(value >= 0 ? "+" : string.Empty)}{value.ToString("0.000", UiCulture)}";

    private static string FormatNullableSignedRmse(double? value)
        => value is null ? "kein Vergleich" : FormatSignedRmse(value.Value);

    private static string FormatPercent(double value) => $"{(value >= 0 ? "+" : string.Empty)}{value.ToString("0.00", UiCulture)}%";

    private static string FormatRatePercent(double value) => $"{(value * 100).ToString("0.00", UiCulture)}%";

    private static string FormatNullableRatePercent(double? value)
        => value is null ? "nicht vorhanden" : FormatRatePercent(value.Value);

    private static string FormatAbsoluteChange(double value)
        => $"{(value >= 0 ? "+" : string.Empty)}{value.ToString("N2", UiCulture)}";

    private static string FormatModelLabel(string rawValue, string fallback)
    {
        return rawValue switch
        {
            "baseline_persistence" => "Persistence-Baseline",
            "random_forest" => "Random Forest",
            "ridge_regression" => "Ridge-Regression",
            "decision_tree" => "Entscheidungsbaum",
            "lstm" => "LSTM",
            _ when !string.IsNullOrWhiteSpace(rawValue) => rawValue.Replace("_", " "),
            _ => fallback,
        };
    }

    private static string GetTrendTone(double value)
    {
        return value switch
        {
            > 0.01 => "tone-positive",
            < -0.01 => "tone-negative",
            _ => "tone-neutral",
        };
    }
}
